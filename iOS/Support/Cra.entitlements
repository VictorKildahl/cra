<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac app's iCloud Documents container (docs/release.md, "iCloud sync"): the phone reads
	     the sidebar the Mac syncs there (SyncedSidebar). Same App ID, so the same container. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dk.kildahl.cra</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.dk.kildahl.cra</string>
	</array>
	<!-- Apple's managed default-browser entitlement (#504): granted to the team on 18 Nov 2026
	     (request 2557T8YX24). Without it iOS doesn't offer Cra under Default Apps ▸ Browser App.
	     The App ID dk.kildahl.cra must have Default Web Browser turned on in the developer portal,
	     or the signing profile lacks it; the Mac app shares that App ID (docs/ios.md). -->
	<key>com.apple.developer.web-browser</key>
	<true/>
	<!-- Links saved from other apps' share sheets wait here (MobileShareInbox). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dk.kildahl.cra</string>
	</array>
</dict>
</plist>
