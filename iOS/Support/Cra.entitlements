<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac app's iCloud Documents container (docs/release.md, "iCloud sync"): the phone reads
	     the sidebar the Mac syncs there (SyncedSidebar). Same App ID, so the same container. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dk.kildahl.cra</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.dk.kildahl.cra</string>
	</array>
	<!-- Links saved from other apps' share sheets wait here (MobileShareInbox). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dk.kildahl.cra</string>
	</array>
</dict>
</plist>
