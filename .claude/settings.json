{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/clips/check-release-media.sh",
            "timeout": 30,
            "statusMessage": "Checking the release notes have clips"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/clean-test-leftovers.sh --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
