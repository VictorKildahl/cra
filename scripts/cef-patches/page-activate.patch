   return opener_host_ && opener_host_->is_views_hosted();
 }
 
+// Cra: "Cra.activate" with true: the client selects the tab and brings its
+// window and the app to the front, as Chrome does for its own tabs.
+void ChromeBrowserDelegate::PageActivationRequested() {
+  auto browser = ChromeBrowserHostImpl::GetBrowserForBrowser(browser_);
+  if (!browser) {
+    return;
+  }
+  auto client = browser->GetClient();
+  if (!client) {
+    return;
+  }
+  CefRefPtr<CefProcessMessage> message =
+      CefProcessMessage::Create("Cra.activate");
+  message->GetArgumentList()->SetBool(0, true);
+  client->OnProcessMessageReceived(browser.get(), browser->GetMainFrame(),
+                                   PID_BROWSER, message);
+}
