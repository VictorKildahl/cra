+
+// Cra: delivered as a "Cra.translate" message from PID_BROWSER whose one
+// argument is the state's JSON.
+void ChromeBrowserDelegate::TranslateStateChanged(const std::string& state) {
+  auto browser = ChromeBrowserHostImpl::GetBrowserForBrowser(browser_);
+  if (!browser) {
+    return;
+  }
+  auto client = browser->GetClient();
+  if (!client) {
+    return;
+  }
+  CefRefPtr<CefProcessMessage> message =
+      CefProcessMessage::Create("Cra.translate");
+  message->GetArgumentList()->SetString(0, state);
+  client->OnProcessMessageReceived(browser.get(), browser->GetMainFrame(),
+                                   PID_BROWSER, message);
 }
 
