+#if BUILDFLAG(ENABLE_CEF)
+// Cra: the client draws Arc's translate UI itself, so the page's translate
+// steps and state go to it ("Cra.translate") instead of Chrome's bubble.
+cef::BrowserDelegate* CraTranslateDelegate(content::WebContents* contents) {
+  BrowserWindowInterface* browser =
+      contents
+          ? GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(contents)
+          : nullptr;
+  cef::BrowserDelegate* delegate = browser ? browser->cef_delegate() : nullptr;
+  return delegate && delegate->IsViewsHosted() ? delegate : nullptr;
+}
+
+const char* CraTranslateStepName(translate::TranslateStep step) {
+  switch (step) {
+    case translate::TRANSLATE_STEP_BEFORE_TRANSLATE:
+      return "offer";
+    case translate::TRANSLATE_STEP_TRANSLATING:
+      return "translating";
+    case translate::TRANSLATE_STEP_AFTER_TRANSLATE:
+      return "translated";
+    case translate::TRANSLATE_STEP_AFTER_UNDO:
+      return "reverted";
+    case translate::TRANSLATE_STEP_TRANSLATE_ERROR:
+      return "error";
+  }
+  return "";
+}
+
+// Sends the state, with `step` empty for a plain state change. False when
+// the page isn't one of the client's, which then keeps Chrome's bubble.
+bool CraSendTranslateState(ChromeTranslateClient* client,
+                           std::string_view step,
+                           translate::TranslateErrors error,
+                           bool user_gesture) {
+  cef::BrowserDelegate* delegate =
+      CraTranslateDelegate(client->web_contents());
+  if (!delegate) {
+    return false;
+  }
+  base::DictValue state = client->CraTranslateState();
+  state.Set("step", step);
+  state.Set("error", static_cast<int>(error));
+  state.Set("userGesture", user_gesture);
+  delegate->TranslateStateChanged(base::WriteJson(state).value_or("{}"));
+  return true;
+}
+
+class CraTranslationObserver
+    : public translate::ContentTranslateDriver::TranslationObserver {
+ public:
+  explicit CraTranslationObserver(ChromeTranslateClient* client)
+      : client_(client) {}
+
+  void OnIsPageTranslatedChanged(content::WebContents* source) override {
+    CraSendTranslateState(client_, "", translate::TranslateErrors::NONE,
+                          false);
+  }
+  void OnTranslateEnabledChanged(content::WebContents* source) override {
+    CraSendTranslateState(client_, "", translate::TranslateErrors::NONE,
+                          false);
+  }
+
+ private:
+  raw_ptr<ChromeTranslateClient> client_;
+};
+#endif  // BUILDFLAG(ENABLE_CEF)
+
