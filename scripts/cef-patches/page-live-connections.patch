diff --git a/content/public/browser/cra_live_connection.h b/content/public/browser/cra_live_connection.h
new file mode 100644
--- /dev/null
+++ b/content/public/browser/cra_live_connection.h
@@ -0,0 +1,26 @@
+// Cra: a page's live connections, for Cra's tab freezing.
+
+#ifndef CONTENT_PUBLIC_BROWSER_CRA_LIVE_CONNECTION_H_
+#define CONTENT_PUBLIC_BROWSER_CRA_LIVE_CONNECTION_H_
+
+#include "content/common/content_export.h"
+
+namespace content {
+
+class WebContents;
+
+// Whether a frame of the page, or a dedicated worker of one, has opened a
+// WebSocket or WebTransport connection (Blink's sticky back/forward cache
+// features, reported whether or not the cache is on). Freezing a page fails its
+// open WebSockets (DOMWebSocket::ContextLifecycleStateChanged), so a chat or
+// mail page frozen in the background would lose its connection; Cra's freezing
+// leaves such a page running.
+CONTENT_EXPORT bool CraPageHasOpenedLiveConnection(WebContents* contents);
+
+// The WebContents user-data key on a page Cra keeps ready for the next tab that
+// needs one (a spare page, Cra.setSpare). Extensions don't see its window.
+CONTENT_EXPORT const void* CraSparePageKey();
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_CRA_LIVE_CONNECTION_H_
