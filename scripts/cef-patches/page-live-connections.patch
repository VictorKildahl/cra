+
+bool CraPageHasOpenedLiveConnection(WebContents* contents) {
+  using Feature = blink::scheduler::WebSchedulerTrackedFeature;
+  bool found = false;
+  static_cast<WebContentsImpl*>(contents)
+      ->GetPrimaryMainFrame()
+      ->ForEachRenderFrameHostImpl([&found](RenderFrameHostImpl* rfh) {
+        const auto features = rfh->GetBackForwardCacheDisablingFeatures();
+        if (features.Has(Feature::kWebSocket) ||
+            features.Has(Feature::kWebSocketSticky) ||
+            features.Has(Feature::kWebTransport) ||
+            features.Has(Feature::kWebTransportSticky)) {
+          found = true;
+        }
+      });
+  return found;
+}
