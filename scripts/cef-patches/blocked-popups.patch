+namespace {
+
+// Cra: the popups Chrome's popup blocker holds back for a page, which Chrome
+// lists from its location bar and CEF has no callback for. Delivered as a
+// "Cra.popups" message from PID_BROWSER whenever the list changes, with the
+// popup ids (argument 0) and their URLs (argument 1), both in Chrome's order.
+void SendCraBlockedPopups(content::WebContents* web_contents) {
+  auto browser = CefBrowserHostBase::GetBrowserForContents(web_contents);
+  auto client = browser ? browser->GetClient() : nullptr;
+  if (!client) {
+    return;
+  }
+  auto* helper =
+      blocked_content::PopupBlockerTabHelper::FromWebContents(web_contents);
+  CefRefPtr<CefListValue> ids = CefListValue::Create();
+  CefRefPtr<CefListValue> urls = CefListValue::Create();
+  if (helper) {
+    size_t index = 0;
+    for (const auto& [id, url] : helper->GetBlockedPopupRequests()) {
+      ids->SetInt(index, id);
+      urls->SetString(index, url.spec());
+      ++index;
+    }
+  }
+  CefRefPtr<CefProcessMessage> message =
+      CefProcessMessage::Create("Cra.popups");
+  message->GetArgumentList()->SetList(0, ids);
+  message->GetArgumentList()->SetList(1, urls);
+  client->OnProcessMessageReceived(browser.get(), browser->GetMainFrame(),
+                                   PID_BROWSER, message);
+}
+
+}  // namespace
