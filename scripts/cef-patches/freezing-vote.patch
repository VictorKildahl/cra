+// Cra (GitHub #273): a tab's back and forward list across a relaunch, the way
+// Chrome's session service keeps it (and Arc, which maps its tabs to Chrome's
+// session tabs).
+// {"id":N,"method":"Cra.getHistory"}: the last committed entry and up to
+// sessions::gMaxPersistNavigationCount entries on each side of it, each a
+// SerializedNavigationEntry with its page state (scroll position, form
+// contents) pickled as a session command holds one, so no more than ~63 KB an
+// entry. {"history":base64 (an int count, then the entries),"index":the
+// current entry's position in it,"url":its address}; "history" is empty for a
+// page that has committed nothing.
+// {"id":N,"method":"Cra.restoreHistory","params":{"history":base64,
+// "index":i}}: puts such a list into a page that hasn't navigated yet, as
+// Chrome's session restore does (NavigationController::Restore), and loads
+// entry i. {"restored":count}.
+constexpr size_t kCraMaxHistoryEntrySize =
+    std::numeric_limits<uint16_t>::max() - 1024;
+
+void HandleCraGetHistory(content::WebContents* contents,
+                         base::DictValue* result) {
+  content::NavigationController& controller = contents->GetController();
+  const int current = controller.GetLastCommittedEntryIndex();
+  content::NavigationEntry* current_entry = controller.GetLastCommittedEntry();
+  std::vector<sessions::SerializedNavigationEntry> navigations;
+  int index = 0;
+  if (current >= 0 && current_entry && !current_entry->IsInitialEntry()) {
+    const int first =
+        std::max(current - sessions::gMaxPersistNavigationCount, 0);
+    const int last =
+        std::min(current + sessions::gMaxPersistNavigationCount,
+                 controller.GetEntryCount() - 1);
+    for (int i = first; i <= last; ++i) {
+      content::NavigationEntry* entry = controller.GetEntryAtIndex(i);
+      if (!entry || entry->IsInitialEntry()) {
+        continue;
+      }
+      if (i == current) {
+        index = static_cast<int>(navigations.size());
+      }
+      navigations.push_back(
+          sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(
+              i, entry));
+    }
+  }
+  std::string history;
+  if (!navigations.empty()) {
+    base::Pickle pickle;
+    pickle.WriteInt(static_cast<int>(navigations.size()));
+    for (const auto& navigation : navigations) {
+      navigation.WriteToPickle(kCraMaxHistoryEntrySize, &pickle);
+    }
+    history = base::Base64Encode(pickle.AsBytes());
+  }
+  result->Set("history", history);
+  result->Set("index", index);
+  result->Set("url", navigations.empty()
+                         ? std::string()
+                         : navigations[index].virtual_url().spec());
+}
+
+void HandleCraRestoreHistory(content::WebContents* contents,
+                             const base::DictValue* params,
+                             base::DictValue* result,
+                             std::string* error) {
+  const std::string* encoded = params ? params->FindString("history") : nullptr;
+  std::optional<int> index = params ? params->FindInt("index") : std::nullopt;
+  std::string bytes;
+  if (!encoded || !index || !base::Base64Decode(*encoded, &bytes)) {
+    *error = "needs history (base64) and index";
+    return;
+  }
+  base::Pickle pickle =
+      base::Pickle::WithUnownedBuffer(base::as_byte_span(bytes));
+  base::PickleIterator iterator(pickle);
+  int count = 0;
+  if (!iterator.ReadInt(&count) || count <= 0 ||
+      count > 2 * sessions::gMaxPersistNavigationCount + 1 || *index < 0 ||
+      *index >= count) {
+    *error = "unreadable history";
+    return;
+  }
+  std::vector<sessions::SerializedNavigationEntry> navigations(count);
+  for (int i = 0; i < count; ++i) {
+    if (!navigations[i].ReadFromPickle(&iterator)) {
+      *error = "unreadable history";
+      return;
+    }
+    navigations[i].set_index(i);
+  }
+  content::NavigationController& controller = contents->GetController();
+  content::NavigationEntry* committed = controller.GetLastCommittedEntry();
+  if (controller.GetEntryCount() > 1 || controller.GetPendingEntry() ||
+      (committed && !committed->IsInitialEntry())) {
+    *error = "the page has navigated already";
+    return;
+  }
+  std::vector<std::unique_ptr<content::NavigationEntry>> entries =
+      sessions::ContentSerializedNavigationBuilder::ToNavigationEntries(
+          navigations, contents->GetBrowserContext());
+  controller.Restore(*index, content::RestoreType::kRestored, &entries);
+  controller.LoadIfNecessary();
+  result->Set("restored", count);
+}
+
+// A reply to a Cra.* method, in the protocol's shape. "id" comes first:
+// CEF's ProtocolParser only reads a result that starts with {"id":, and
+// JSONWriter would sort "error" ahead of it, so error replies never arrived.
+std::string CraReplyJson(int message_id,
+                         base::DictValue result,
+                         const std::string& error) {
+  std::string body;
+  if (error.empty()) {
+    base::JSONWriter::Write(result, &body);
+  } else {
+    base::DictValue error_dict;
+    error_dict.Set("code", -32000);
+    error_dict.Set("message", error);
+    base::JSONWriter::Write(error_dict, &body);
+  }
+  return "{\"id\":" + base::NumberToString(message_id) +
+         (error.empty() ? ",\"result\":" : ",\"error\":") + body + "}";
+}
