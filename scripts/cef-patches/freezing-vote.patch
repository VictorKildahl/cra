+// Cra: a page's freezing vote, held while the client asks for it, like Arc's
+// freeze token. Chromium's freezing policy freezes the page only while no
+// CannotFreezeReason applies (audible, capturing, Web Locks, WebRTC,
+// notification permission, ...).
+const char kCraFreezingVoteKey[] = "cra-freezing-vote";
+
+struct CraFreezingVote : public base::SupportsUserData::Data {
+  explicit CraFreezingVote(content::WebContents* contents) : vote(contents) {}
+  performance_manager::freezing::FreezingVote vote;
+};
+
+base::ListValue ReasonList(
+    const performance_manager::freezing::CannotFreezeReasonSet& reasons) {
+  base::ListValue list;
+  for (auto reason : reasons) {
+    list.Append(
+        performance_manager::freezing::CannotFreezeReasonToString(reason));
+  }
+  return list;
+}
+
+// Cra: the page's media session as Chromium routes it (the frame whose
+// navigator.mediaSession handlers answer), like Arc's media actions. Unlike a
+// wrapper around setActionHandler in the page, this sees every handler however
+// early the page registered it.
+struct CraMediaSessionActionName {
+  media_session::mojom::MediaSessionAction action;
+  const char* name;
+};
+constexpr CraMediaSessionActionName kCraMediaSessionActions[] = {
+    {media_session::mojom::MediaSessionAction::kPlay, "play"},
+    {media_session::mojom::MediaSessionAction::kPause, "pause"},
+    {media_session::mojom::MediaSessionAction::kPreviousTrack, "previoustrack"},
+    {media_session::mojom::MediaSessionAction::kNextTrack, "nexttrack"},
+    {media_session::mojom::MediaSessionAction::kSeekBackward, "seekbackward"},
+    {media_session::mojom::MediaSessionAction::kSeekForward, "seekforward"},
+    {media_session::mojom::MediaSessionAction::kSkipAd, "skipad"},
+    {media_session::mojom::MediaSessionAction::kStop, "stop"},
+    {media_session::mojom::MediaSessionAction::kToggleMicrophone,
+     "togglemicrophone"},
+    {media_session::mojom::MediaSessionAction::kToggleCamera, "togglecamera"},
+    {media_session::mojom::MediaSessionAction::kHangUp, "hangup"},
+    {media_session::mojom::MediaSessionAction::kPreviousSlide,
+     "previousslide"},
+    {media_session::mojom::MediaSessionAction::kNextSlide, "nextslide"},
+};
+
+// {"id":N,"method":"Cra.mediaSession"}: {"actions":[names],
+// "pictureInPicture":bool}, the actions the page has handlers for and whether
+// this page has the Picture in Picture window.
+// {"id":N,"method":"Cra.mediaSession","params":{"action":name}}: runs the
+// page's handler for it, as Chrome's media keys and global media controls do;
+// "handled" is false when the page has none.
+void HandleCraMediaSession(content::WebContents* contents,
+                           const base::DictValue* params,
+                           base::DictValue* result,
+                           std::string* error) {
+  auto* session = static_cast<content::MediaSessionImpl*>(
+      content::MediaSession::GetIfExists(contents));
+  auto* pip = PictureInPictureWindowManager::GetInstance();
+  const bool has_pip = pip->GetWebContents() == contents;
+  result->Set("pictureInPicture", has_pip);
+  const std::string* name = params ? params->FindString("action") : nullptr;
+  if (!name) {
+    base::ListValue actions;
+    for (const auto& entry : kCraMediaSessionActions) {
+      if (session && session->ShouldRouteAction(entry.action)) {
+        actions.Append(entry.name);
+      }
+    }
+    result->Set("actions", std::move(actions));
+    return;
+  }
+  const CraMediaSessionActionName* found = nullptr;
+  for (const auto& entry : kCraMediaSessionActions) {
+    if (*name == entry.name) {
+      found = &entry;
+    }
+  }
+  if (!found) {
+    *error = "unknown media session action";
+    return;
+  }
+  const bool routed = session && session->ShouldRouteAction(found->action);
+  if (routed) {
+    session->DidReceiveAction(found->action);
+  }
+  result->Set("handled", routed);
+}
+
+// Cra: Chrome's automatic Picture in Picture (AutoPictureInPictureTabHelper),
+// which a tab strip drives in Chrome and the client drives here.
+// {"id":N,"method":"Cra.autoPictureInPicture","params":{"tab":"hidden"}}: the
+// tab went out of sight. A page that registered an enterpictureinpicture media
+// session handler and uses the camera or microphone (a Google Meet call) has it
+// run, with the reason "contentoccluded" and the browser's authorization to
+// open its Picture in Picture window; {"asked":bool}. Chrome's per-site
+// automatic picture-in-picture permission applies, and nothing replaces a
+// Picture in Picture window that is already open ({"pictureInPicture":true}
+// when this page has it).
+// {"id":N,"method":"Cra.autoPictureInPicture","params":{"tab":"shown"}}: the
+// tab is in front again, which closes the window automatic Picture in Picture
+// opened, as Chrome does.
+void HandleCraAutoPictureInPicture(content::WebContents* contents,
+                                   const base::DictValue* params,
+                                   base::DictValue* result,
+                                   std::string* error) {
+  auto* helper = AutoPictureInPictureTabHelper::FromWebContents(contents);
+  const std::string* tab = params ? params->FindString("tab") : nullptr;
+  if (!helper) {
+    *error = "no automatic Picture in Picture for this page";
+    return;
+  }
+  if (tab && *tab == "shown") {
+    helper->OnTabBecameActive();
+    return;
+  }
+  if (!tab || *tab != "hidden") {
+    *error = "tab must be hidden or shown";
+    return;
+  }
+  result->Set("pictureInPicture",
+              PictureInPictureWindowManager::GetInstance()->GetWebContents() ==
+                  contents);
+  result->Set("asked", helper->CraOnTabHidden());
+}
+
+// {"id":N,"method":"Cra.setFreezingVote","params":{"vote":true|false}}: sets
+// or drops the vote. {"id":N,"method":"Cra.getFreezingState"}: whether the
+// page has Cra's vote, is frozen, and why the policy won't freeze it.
+// {"id":N,"method":"Cra.discard"}: discards the page in place, like Chrome's
+// TabLifecycleUnit with WebContentsDiscard on: its renderer goes, the
+// WebContents keeps its back/forward list and each entry's page state (scroll
+// position, form contents), and showing it loads the page again.
+// {"id":N,"method":"Cra.load"}: loads a discarded page now, as Chrome does
+// when its tab is selected, even while the window is covered.
+// Returns true for these; any other message returns false.
+bool HandleCraMethod(content::WebContents* contents,
+                     std::string_view message,
+                     int* message_id,
+                     base::DictValue* result,
+                     std::string* error) {
+  if (message.find("\"Cra.") == std::string_view::npos) {
+    return false;
+  }
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(message, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return false;
+  }
+  const std::string* method = dict->FindString("method");
+  std::optional<int> id = dict->FindInt("id");
+  if (!method || !id ||
+      (*method != "Cra.setFreezingVote" && *method != "Cra.getFreezingState" &&
+       *method != "Cra.discard" && *method != "Cra.load" &&
+       *method != "Cra.mediaSession" && *method != "Cra.autoPictureInPicture")) {
+    return false;
+  }
+  *message_id = *id;
+  if (*method == "Cra.autoPictureInPicture") {
+    HandleCraAutoPictureInPicture(contents, dict->FindDict("params"), result,
+                                  error);
+    return true;
+  }
+  if (*method == "Cra.mediaSession") {
+    HandleCraMediaSession(contents, dict->FindDict("params"), result, error);
+    return true;
+  }
+  if (*method == "Cra.load") {
+    // Does nothing unless the page was discarded and hasn't loaded since.
+    contents->GetController().LoadIfNecessary();
+    return true;
+  }
+  if (*method == "Cra.discard") {
+    if (!base::FeatureList::IsEnabled(features::kWebContentsDiscard)) {
+      *error = "discarding needs the WebContentsDiscard feature";
+      return true;
+    }
+    if (!contents->WasDiscarded()) {
+      // First try to end the renderer, if it holds only this page
+      // (AttemptFastKillForDiscard).
+      content::RenderFrameHost* main_frame = contents->GetPrimaryMainFrame();
+      result->Set("processEnded",
+                  main_frame && main_frame->GetProcess()->FastShutdownIfPossible(
+                                    1u, /*skip_unload_handlers=*/false,
+                                    /*ignore_workers=*/false,
+                                    /*ignore_keep_alive=*/false,
+                                    /*ignore_pending_reuse=*/false,
+                                    /*use_outermost_main_frame_check=*/true));
+      contents->Discard(base::DoNothing());
+    }
+    // False when a navigation was about to commit: Chromium keeps the page.
+    result->Set("discarded", contents->WasDiscarded());
+    return true;
+  }
+  if (*method == "Cra.getFreezingState") {
+    result->Set("vote", !!contents->GetUserData(kCraFreezingVoteKey));
+    const performance_manager::PageNode* page =
+        performance_manager::PerformanceManager::
+            GetPrimaryPageNodeForWebContents(contents)
+                .get();
+    if (page && performance_manager::PerformanceManager::GetGraph()
+                    ->GetRegisteredObjectAs<
+                        performance_manager::FreezingPolicy>()) {
+      result->Set("frozen", page->GetLifecycleState() ==
+                                performance_manager::mojom::LifecycleState::kFrozen);
+      auto details =
+          performance_manager::freezing::GetCanFreezeDetailsForPageNode(page);
+      result->Set("reasons", ReasonList(details.cannot_freeze_reasons));
+      result->Set("connectedReasons",
+                  ReasonList(details.cannot_freeze_reasons_connected_pages));
+    }
+    return true;
+  }
+  const base::DictValue* params = dict->FindDict("params");
+  const bool vote = params && params->FindBool("vote").value_or(false);
+  if (!vote) {
+    contents->RemoveUserData(kCraFreezingVoteKey);
+    return true;
+  }
+  if (contents->GetUserData(kCraFreezingVoteKey)) {
+    return true;
+  }
+  // FreezingVote CHECKs both: a page Chrome's tab helpers never saw has no
+  // page node.
+  auto* graph = performance_manager::PerformanceManager::GetGraph();
+  if (!performance_manager::PerformanceManager::
+          GetPrimaryPageNodeForWebContents(contents) ||
+      !graph ||
+      !graph->GetRegisteredObjectAs<
+          performance_manager::FreezingPolicy>()) {
+    *error = "freezing is not available for this page";
+    return true;
+  }
+  contents->SetUserData(kCraFreezingVoteKey,
+                        std::make_unique<CraFreezingVote>(contents));
+  return true;
+}
