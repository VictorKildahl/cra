+// {"id":N,"method":"Cra.mediaSession"}: {"actions":[names],
+// "pictureInPicture":bool}, the actions the page has handlers for and whether
+// this page has the Picture in Picture window.
+// {"id":N,"method":"Cra.mediaSession","params":{"action":name}}: runs the
+// page's handler for it, as Chrome's media keys and global media controls do;
+// "handled" is false when the page has none.
+void HandleCraMediaSession(content::WebContents* contents,
+                           const base::DictValue* params,
+                           base::DictValue* result,
+                           std::string* error) {
+  auto* session = static_cast<content::MediaSessionImpl*>(
+      content::MediaSession::GetIfExists(contents));
+  auto* pip = PictureInPictureWindowManager::GetInstance();
+  const bool has_pip = pip->GetWebContents() == contents;
+  result->Set("pictureInPicture", has_pip);
+  const std::string* name = params ? params->FindString("action") : nullptr;
+  if (!name) {
+    base::ListValue actions;
+    for (const auto& entry : kCraMediaSessionActions) {
+      if (session && session->ShouldRouteAction(entry.action)) {
+        actions.Append(entry.name);
+      }
+    }
+    result->Set("actions", std::move(actions));
+    return;
+  }
+  const CraMediaSessionActionName* found = nullptr;
+  for (const auto& entry : kCraMediaSessionActions) {
+    if (*name == entry.name) {
+      found = &entry;
+    }
+  }
+  if (!found) {
+    *error = "unknown media session action";
+    return;
+  }
+  const bool routed = session && session->ShouldRouteAction(found->action);
+  if (routed) {
+    session->DidReceiveAction(found->action);
+  }
+  result->Set("handled", routed);
+}
