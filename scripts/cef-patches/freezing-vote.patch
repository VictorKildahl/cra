+// The page that downloads the store's CRX, as WebstoreInstallWithPrompt has
+// one: never shown, so the download stays out of every window's UI. It lives
+// until the install is over.
+struct CraWebStoreInstallPage
+    : public base::RefCountedThreadSafe<CraWebStoreInstallPage> {
+  explicit CraWebStoreInstallPage(Profile* profile)
+      : contents(content::WebContents::Create(
+            content::WebContents::CreateParams(profile))) {}
+  std::unique_ptr<content::WebContents> contents;
+
+ private:
+  friend class base::RefCountedThreadSafe<CraWebStoreInstallPage>;
+  ~CraWebStoreInstallPage() = default;
+};
+
+// Cra (GitHub #203): {"id":N,"method":"Cra.installFromWebStore","params":
+// {"id":extension id,"manifest":{...}}} installs a Chrome Web Store item in
+// this page's profile the way the store's "Add to Chrome" does
+// (webstorePrivate.completeInstall): WebstoreInstaller fetches the signed CRX
+// from the store's update service and CrxInstaller checks it carries the
+// store's signature. It lands as INTERNAL and from the Web Store, updates and
+// is verified like any store install, which an unpacked copy (Arc's, Dia's,
+// Chrome's, loaded with --load-extension) never is. `manifest` is the copy
+// the person picked; the store's version may not ask for more permissions
+// (a loose check). No prompt: the client asks only for extensions the person
+// chose to bring over. Replies {"installed":true} once the extension is
+// installed, else an error; the download can take a while.
+// Returns false for any other message.
+bool StartCraWebStoreInstall(
+    content::WebContents* contents,
+    std::string_view message,
+    base::OnceCallback<void(std::string json)> send) {
+  if (message.find("\"Cra.installFromWebStore\"") == std::string_view::npos) {
+    return false;
+  }
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(message, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return false;
+  }
+  const std::string* method = dict->FindString("method");
+  std::optional<int> message_id = dict->FindInt("id");
+  if (!method || !message_id || *method != "Cra.installFromWebStore") {
+    return false;
+  }
+  auto fail = [&](const std::string& error) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(send),
+                                  CraReplyJson(*message_id, base::DictValue(),
+                                               error)));
+    return true;
+  };
+  const base::DictValue* params = dict->FindDict("params");
+  const std::string* id = params ? params->FindString("id") : nullptr;
+  const base::DictValue* manifest =
+      params ? params->FindDict("manifest") : nullptr;
+  if (!id || !crx_file::id_util::IdIsValid(*id) || !manifest) {
+    return fail("needs a valid extension id and its manifest");
+  }
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  if (!profile || profile->IsOffTheRecord()) {
+    return fail("not in an off-the-record profile");
+  }
+  const extensions::Extension* installed =
+      extensions::ExtensionRegistry::Get(profile)->GetInstalledExtension(*id);
+  if (installed &&
+      installed->location() == extensions::mojom::ManifestLocation::kInternal &&
+      installed->from_webstore()) {
+    base::DictValue result;
+    result.Set("installed", true);
+    result.Set("already", true);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(send),
+                                  CraReplyJson(*message_id, std::move(result),
+                                               std::string())));
+    return true;
+  }
+  std::unique_ptr<extensions::InstallApproval> approval =
+      extensions::InstallApproval::CreateWithNoInstallPrompt(
+          profile, *id, manifest->Clone(), /*strict_manifest_check=*/false);
+  approval->skip_post_install_ui = true;
+  approval->use_app_installed_bubble = false;
+  auto page = base::MakeRefCounted<CraWebStoreInstallPage>(profile);
+  // One of the two callbacks runs; both hold the page and the reply.
+  auto split = base::SplitOnceCallback(std::move(send));
+  auto installer = base::MakeRefCounted<extensions::WebstoreInstaller>(
+      profile,
+      base::BindOnce(
+          [](scoped_refptr<CraWebStoreInstallPage>, int message_id,
+             base::OnceCallback<void(std::string)> send, const std::string&) {
+            base::DictValue result;
+            result.Set("installed", true);
+            std::move(send).Run(CraReplyJson(message_id, std::move(result),
+                                             std::string()));
+          },
+          page, *message_id, std::move(split.first)),
+      base::BindOnce(
+          [](scoped_refptr<CraWebStoreInstallPage>, int message_id,
+             base::OnceCallback<void(std::string)> send, const std::string& id,
+             const std::string& error,
+             extensions::WebstoreInstaller::FailureReason) {
+            LOG(WARNING) << "Cra: Web Store install of " << id
+                         << " failed: " << error;
+            std::move(send).Run(CraReplyJson(
+                message_id, base::DictValue(),
+                error.empty() ? std::string("install failed") : error));
+          },
+          page, *message_id, std::move(split.second)),
+      page->contents.get(), *id, std::move(approval),
+      extensions::WebstoreInstaller::INSTALL_SOURCE_OTHER);
+  installer->Start();
+  return true;
+}
+
+bool HandleCraMethod(content::WebContents* contents,
+                     std::string_view message,
+                     int* message_id,
+                     base::DictValue* result,
+                     std::string* error) {
+  if (message.find("\"Cra.") == std::string_view::npos) {
+    return false;
+  }
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(message, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return false;
+  }
+  const std::string* method = dict->FindString("method");
+  std::optional<int> id = dict->FindInt("id");
+  if (!method || !id ||
+      (*method != "Cra.setFreezingVote" && *method != "Cra.getFreezingState" &&
+       *method != "Cra.discard" && *method != "Cra.load" &&
+       *method != "Cra.mediaSession" && *method != "Cra.autoPictureInPicture")) {
+    return false;
+  }
+  *message_id = *id;
+  if (*method == "Cra.autoPictureInPicture") {
+    HandleCraAutoPictureInPicture(contents, dict->FindDict("params"), result,
+                                  error);
+    return true;
+  }
+  if (*method == "Cra.mediaSession") {
+    HandleCraMediaSession(contents, dict->FindDict("params"), result, error);
+    return true;
+  }
+  if (*method == "Cra.load") {
+    // Does nothing unless the page was discarded and hasn't loaded since.
+    contents->GetController().LoadIfNecessary();
+    return true;
+  }
+  if (*method == "Cra.discard") {
+    if (!base::FeatureList::IsEnabled(features::kWebContentsDiscard)) {
+      *error = "discarding needs the WebContentsDiscard feature";
+      return true;
+    }
+    if (!contents->WasDiscarded()) {
+      // First try to end the renderer, if it holds only this page
+      // (AttemptFastKillForDiscard).
+      content::RenderFrameHost* main_frame = contents->GetPrimaryMainFrame();
+      result->Set("processEnded",
+                  main_frame && main_frame->GetProcess()->FastShutdownIfPossible(
+                                    1u, /*skip_unload_handlers=*/false,
+                                    /*ignore_workers=*/false,
+                                    /*ignore_keep_alive=*/false,
+                                    /*ignore_pending_reuse=*/false,
+                                    /*use_outermost_main_frame_check=*/true));
+      contents->Discard(base::DoNothing());
+    }
+    // False when a navigation was about to commit: Chromium keeps the page.
+    result->Set("discarded", contents->WasDiscarded());
+    return true;
+  }
+  if (*method == "Cra.getFreezingState") {
+    result->Set("vote", !!contents->GetUserData(kCraFreezingVoteKey));
+    const performance_manager::PageNode* page =
+        performance_manager::PerformanceManager::
+            GetPrimaryPageNodeForWebContents(contents)
+                .get();
+    if (page && performance_manager::PerformanceManager::GetGraph()
+                    ->GetRegisteredObjectAs<
+                        performance_manager::FreezingPolicy>()) {
+      result->Set("frozen", page->GetLifecycleState() ==
+                                performance_manager::mojom::LifecycleState::kFrozen);
+      auto details =
+          performance_manager::freezing::GetCanFreezeDetailsForPageNode(page);
+      result->Set("reasons", ReasonList(details.cannot_freeze_reasons));
+      result->Set("connectedReasons",
+                  ReasonList(details.cannot_freeze_reasons_connected_pages));
+    }
+    return true;
+  }
+  const base::DictValue* params = dict->FindDict("params");
+  const bool vote = params && params->FindBool("vote").value_or(false);
+  if (!vote) {
+    contents->RemoveUserData(kCraFreezingVoteKey);
+    return true;
+  }
+  if (contents->GetUserData(kCraFreezingVoteKey)) {
+    return true;
+  }
+  // FreezingVote CHECKs both: a page Chrome's tab helpers never saw has no
+  // page node.
+  auto* graph = performance_manager::PerformanceManager::GetGraph();
+  if (!performance_manager::PerformanceManager::
+          GetPrimaryPageNodeForWebContents(contents) ||
+      !graph ||
+      !graph->GetRegisteredObjectAs<
+          performance_manager::FreezingPolicy>()) {
+    *error = "freezing is not available for this page";
+    return true;
+  }
+  contents->SetUserData(kCraFreezingVoteKey,
+                        std::make_unique<CraFreezingVote>(contents));
+  return true;
+}
