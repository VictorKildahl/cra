+// Cra: Chrome's automatic Picture in Picture (AutoPictureInPictureTabHelper),
+// which a tab strip drives in Chrome and the client drives here.
+// {"id":N,"method":"Cra.autoPictureInPicture","params":{"tab":"hidden"}}: the
+// tab went out of sight. A page that registered an enterpictureinpicture media
+// session handler and uses the camera or microphone (a Google Meet call) has it
+// run, with the reason "contentoccluded" and the browser's authorization to
+// open its Picture in Picture window; {"asked":bool}. Chrome's per-site
+// automatic picture-in-picture permission applies, and nothing replaces a
+// Picture in Picture window that is already open ({"pictureInPicture":true}
+// when this page has it).
+// {"id":N,"method":"Cra.autoPictureInPicture","params":{"tab":"shown"}}: the
+// tab is in front again, which closes the window automatic Picture in Picture
+// opened, as Chrome does.
+void HandleCraAutoPictureInPicture(content::WebContents* contents,
+                                   const base::DictValue* params,
+                                   base::DictValue* result,
+                                   std::string* error) {
+  auto* helper = AutoPictureInPictureTabHelper::FromWebContents(contents);
+  const std::string* tab = params ? params->FindString("tab") : nullptr;
+  if (!helper) {
+    *error = "no automatic Picture in Picture for this page";
+    return;
+  }
+  if (tab && *tab == "shown") {
+    helper->OnTabBecameActive();
+    return;
+  }
+  if (!tab || *tab != "hidden") {
+    *error = "tab must be hidden or shown";
+    return;
+  }
+  result->Set("pictureInPicture",
+              PictureInPictureWindowManager::GetInstance()->GetWebContents() ==
+                  contents);
+  result->Set("asked", helper->CraOnTabHidden());
+}
