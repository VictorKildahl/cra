+// Cra (GitHub #310): Arc's translate UI, which Cra draws itself. Every
+// method replies with the page's state (ChromeTranslateClient::
+// CraTranslateState); Cra.getTranslateState adds the languages Chrome can
+// translate to. Cra.translatePage translates to params.target, or to the
+// language Chrome would pick, as the bubble's Translate button does.
+// Cra.neverTranslateSite puts the page's host on Chrome's never-translate
+// list, or takes it off with params.never false.
+void HandleCraTranslate(content::WebContents* contents,
+                        const std::string& method,
+                        const base::DictValue* params,
+                        base::DictValue* result,
+                        std::string* error) {
+  ChromeTranslateClient* client =
+      ChromeTranslateClient::FromWebContents(contents);
+  translate::TranslateManager* manager =
+      client ? client->GetTranslateManager() : nullptr;
+  if (!manager) {
+    *error = "the page has no translate client";
+    return;
+  }
+  if (method == "Cra.translatePage") {
+    const std::string* target = params ? params->FindString("target") : nullptr;
+    std::optional<std::string> target_code;
+    if (target && !target->empty()) {
+      target_code = *target;
+    }
+    manager->ShowTranslateUI(std::nullopt, target_code,
+                             /*auto_translate=*/true,
+                             /*triggered_from_menu=*/true);
+  } else if (method == "Cra.revertTranslation") {
+    if (client->GetLanguageState().IsPageTranslated()) {
+      manager->RevertTranslation();
+    }
+  } else if (method == "Cra.neverTranslateSite") {
+    const GURL& url = contents->GetLastCommittedURL();
+    if (!url.has_host()) {
+      *error = "the page has no site";
+      return;
+    }
+    std::optional<bool> never =
+        params ? params->FindBool("never") : std::nullopt;
+    std::unique_ptr<translate::TranslatePrefs> prefs =
+        client->GetTranslatePrefs();
+    if (never.value_or(true)) {
+      prefs->AddSiteToNeverPromptList(url.host());
+    } else {
+      prefs->RemoveSiteFromNeverPromptList(url.host());
+    }
+  }
+  *result = client->CraTranslateState();
+  if (method == "Cra.getTranslateState") {
+    std::vector<std::string> codes;
+    translate::TranslateDownloadManager::GetSupportedLanguages(
+        /*translate_allowed=*/true, &codes);
+    base::ListValue languages;
+    for (const std::string& code : codes) {
+      languages.Append(code);
+    }
+    result->Set("languages", std::move(languages));
+  }
+}
