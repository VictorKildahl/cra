+// The page that downloads the store's CRX, as WebstoreInstallWithPrompt has
+// one: never shown, so the download stays out of every window's UI. It lives
+// until the install is over, or until its profile goes away: a quit while an
+// install still ran (or never ended) destroyed the profile with the page open,
+// and Chromium stops on that ("BrowserContext is getting destroyed without
+// first closing all WebContents", GitHub #227). WebstoreInstaller holds the
+// page through a WeakPtr; an install cut off this way never replies, and the
+// client asks for it again on the next launch.
+struct CraWebStoreInstallPage
+    : public base::RefCountedThreadSafe<CraWebStoreInstallPage>,
+      public ProfileObserver {
+  explicit CraWebStoreInstallPage(Profile* profile)
+      : contents(content::WebContents::Create(
+            content::WebContents::CreateParams(profile))) {
+    profile_observation_.Observe(profile);
+  }
+  std::unique_ptr<content::WebContents> contents;
+
+  // ProfileObserver: first thing in ~ProfileImpl, before its user data (the
+  // list of the profile's WebContents) is checked and cleared.
+  void OnProfileWillBeDestroyed(Profile* profile) override {
+    profile_observation_.Reset();
+    contents.reset();
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<CraWebStoreInstallPage>;
+  ~CraWebStoreInstallPage() override = default;
+
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+};
