+// Cra (GitHub #203): {"id":N,"method":"Cra.installFromWebStore","params":
+// {"id":extension id,"manifest":{...}}} installs a Chrome Web Store item in
+// this page's profile the way the store's "Add to Chrome" does
+// (webstorePrivate.completeInstall): WebstoreInstaller fetches the signed CRX
+// from the store's update service and CrxInstaller checks it carries the
+// store's signature. It lands as INTERNAL and from the Web Store, updates and
+// is verified like any store install, which an unpacked copy (Arc's, Dia's,
+// Chrome's, loaded with --load-extension) never is. `manifest` is the copy
+// the person picked; the store's version may not ask for more permissions
+// (a loose check). No prompt: the client asks only for extensions the person
+// chose to bring over. Replies {"installed":true} once the extension is
+// installed, else an error; the download can take a while.
+// Returns false for any other message.
+bool StartCraWebStoreInstall(
+    content::WebContents* contents,
+    std::string_view message,
+    base::OnceCallback<void(std::string json)> send) {
+  if (message.find("\"Cra.installFromWebStore\"") == std::string_view::npos) {
+    return false;
+  }
+  std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(message, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return false;
+  }
+  const std::string* method = dict->FindString("method");
+  std::optional<int> message_id = dict->FindInt("id");
+  if (!method || !message_id || *method != "Cra.installFromWebStore") {
+    return false;
+  }
+  auto fail = [&](const std::string& error) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(send),
+                                  CraReplyJson(*message_id, base::DictValue(),
+                                               error)));
+    return true;
+  };
+  const base::DictValue* params = dict->FindDict("params");
+  const std::string* id = params ? params->FindString("id") : nullptr;
+  const base::DictValue* manifest =
+      params ? params->FindDict("manifest") : nullptr;
+  if (!id || !crx_file::id_util::IdIsValid(*id) || !manifest) {
+    return fail("needs a valid extension id and its manifest");
+  }
+  Profile* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  if (!profile || profile->IsOffTheRecord()) {
+    return fail("not in an off-the-record profile");
+  }
+  const extensions::Extension* installed =
+      extensions::ExtensionRegistry::Get(profile)->GetInstalledExtension(*id);
+  if (installed &&
+      installed->location() == extensions::mojom::ManifestLocation::kInternal &&
+      installed->from_webstore()) {
+    base::DictValue result;
+    result.Set("installed", true);
+    result.Set("already", true);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(send),
+                                  CraReplyJson(*message_id, std::move(result),
+                                               std::string())));
+    return true;
+  }
+  std::unique_ptr<extensions::InstallApproval> approval =
+      extensions::InstallApproval::CreateWithNoInstallPrompt(
+          profile, *id, manifest->Clone(), /*strict_manifest_check=*/false);
+  approval->skip_post_install_ui = true;
+  approval->use_app_installed_bubble = false;
+  auto page = base::MakeRefCounted<CraWebStoreInstallPage>(profile);
+  // One of the two callbacks runs; both hold the page and the reply.
+  auto split = base::SplitOnceCallback(std::move(send));
+  auto installer = base::MakeRefCounted<extensions::WebstoreInstaller>(
+      profile,
+      base::BindOnce(
+          [](scoped_refptr<CraWebStoreInstallPage>, int message_id,
+             base::OnceCallback<void(std::string)> send, const std::string&) {
+            base::DictValue result;
+            result.Set("installed", true);
+            std::move(send).Run(CraReplyJson(message_id, std::move(result),
+                                             std::string()));
+          },
+          page, *message_id, std::move(split.first)),
+      base::BindOnce(
+          [](scoped_refptr<CraWebStoreInstallPage>, int message_id,
+             base::OnceCallback<void(std::string)> send, const std::string& id,
+             const std::string& error,
+             extensions::WebstoreInstaller::FailureReason) {
+            LOG(WARNING) << "Cra: Web Store install of " << id
+                         << " failed: " << error;
+            std::move(send).Run(CraReplyJson(
+                message_id, base::DictValue(),
+                error.empty() ? std::string("install failed") : error));
+          },
+          page, *message_id, std::move(split.second)),
+      page->contents.get(), *id, std::move(approval),
+      extensions::WebstoreInstaller::INSTALL_SOURCE_OTHER);
+  installer->Start();
+  return true;
+}
