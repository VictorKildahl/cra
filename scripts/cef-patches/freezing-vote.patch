+// Cra: Chrome's automatic Picture in Picture (AutoPictureInPictureTabHelper),
+// which a tab strip drives in Chrome and the client drives here.
+// {"id":N,"method":"Cra.autoPictureInPicture","params":{"tab":"hidden"}}: the
+// tab went out of sight. A page that registered an enterpictureinpicture media
+// session handler and uses the camera or microphone (a Google Meet call) has it
+// run, with the reason "contentoccluded" and the browser's authorization to
+// open its Picture in Picture window; {"asked":bool}. Chrome's per-site
+// automatic picture-in-picture permission applies, and nothing replaces a
+// Picture in Picture window that is already open ({"pictureInPicture":true}
+// when this page has it).
+// {"id":N,"method":"Cra.autoPictureInPicture","params":{"tab":"shown"}}: the
+// tab is in front again, which closes the window automatic Picture in Picture
+// opened, as Chrome does.
+void HandleCraAutoPictureInPicture(content::WebContents* contents,
+                                   const base::DictValue* params,
+                                   base::DictValue* result,
+                                   std::string* error) {
+  auto* helper = AutoPictureInPictureTabHelper::FromWebContents(contents);
+  const std::string* tab = params ? params->FindString("tab") : nullptr;
+  if (!helper) {
+    *error = "no automatic Picture in Picture for this page";
+    return;
+  }
+  if (tab && *tab == "shown") {
+    helper->OnTabBecameActive();
+    return;
+  }
+  if (!tab || *tab != "hidden") {
+    *error = "tab must be hidden or shown";
+    return;
+  }
+  result->Set("pictureInPicture",
+              PictureInPictureWindowManager::GetInstance()->GetWebContents() ==
+                  contents);
+  result->Set("asked", helper->CraOnTabHidden());
+}
+
+// {"id":N,"method":"Cra.setFreezingVote","params":{"vote":true|false}}: sets
+// or drops the vote. {"id":N,"method":"Cra.getFreezingState"}: whether the
+// page has Cra's vote, is frozen, and why the policy won't freeze it.
+// {"id":N,"method":"Cra.discard"}: discards the page in place, like Chrome's
+// TabLifecycleUnit with WebContentsDiscard on: its renderer goes, the
+// WebContents keeps its back/forward list and each entry's page state (scroll
+// position, form contents), and showing it loads the page again.
+// {"id":N,"method":"Cra.load"}: loads a discarded page now, as Chrome does
+// when its tab is selected, even while the window is covered.
+// Returns true for these; any other message returns false.
+bool HandleCraMethod(content::WebContents* contents,
+                     std::string_view message,
+                     int* message_id,
+                     base::DictValue* result,
+                     std::string* error);
+
+// A reply to a Cra.* method, in the protocol's shape. "id" comes first:
+// CEF's ProtocolParser only reads a result that starts with {"id":, and
+// JSONWriter would sort "error" ahead of it, so error replies never arrived.
+std::string CraReplyJson(int message_id,
+                         base::DictValue result,
+                         const std::string& error) {
+  std::string body;
+  if (error.empty()) {
+    base::JSONWriter::Write(result, &body);
+  } else {
+    base::DictValue error_dict;
+    error_dict.Set("code", -32000);
+    error_dict.Set("message", error);
+    base::JSONWriter::Write(error_dict, &body);
+  }
+  return "{\"id\":" + base::NumberToString(message_id) +
+         (error.empty() ? ",\"result\":" : ",\"error\":") + body + "}";
+}
