+
+// Cra: Chrome opens an extension's chrome.tabs.create in a tabbed Browser of
+// its own, which a client sees only as a browser with the default client. Cra
+// replaced it with a page of its own, and the extension was left with the id of
+// a tab that never loaded (GitHub #292). Here the new tab is offered to this
+// browser's client the way a window.open popup is: OnBeforePopup, with
+// "cra_extension_tab" in |extra_info|, which no page can set (a page picks its
+// popup's frame name). When the client takes it, the WebContents becomes a
+// Views-hosted popup Browser's only tab, the one the extension gets back. Steps
+// as in CreateDevToolsBrowser above.
+content::WebContents* ChromeBrowserDelegate::OpenExtensionTab(const GURL& url,
+                                                              bool active) {
+  if (!IsViewsHosted() || browser_->GetType() != Browser::TYPE_POPUP) {
+    return nullptr;
+  }
+  auto opener_host = ChromeBrowserHostImpl::GetBrowserForBrowser(browser_);
+  if (!opener_host) {
+    return nullptr;
+  }
+  auto opener_client = opener_host->GetClient();
+  auto life_span_handler =
+      opener_client ? opener_client->GetLifeSpanHandler() : nullptr;
+  if (!life_span_handler) {
+    return nullptr;
+  }
+
+  // 1. Ask the client, starting with the opener's client and settings.
+  CefBrowserCreateParams create_params;
+  create_params.client = opener_client;
+  create_params.settings = opener_host->settings();
+  create_params.extra_info = CefDictionaryValue::Create();
+  create_params.extra_info->SetBool("cra_extension_tab", true);
+  CefWindowInfo window_info;
+  CefBrowserCreateParams::InitWindowInfo(&window_info, opener_host.get());
+  CefPopupFeatures features;
+  bool no_javascript_access = false;
+  if (life_span_handler->OnBeforePopup(
+          opener_host.get(), opener_host->GetMainFrame(),
+          opener_host->GetNextPopupId(), url.spec(), CefString(),
+          active ? CEF_WOD_NEW_FOREGROUND_TAB : CEF_WOD_NEW_BACKGROUND_TAB,
+          /*user_gesture=*/false, features, window_info, create_params.client,
+          create_params.settings, create_params.extra_info,
+          &no_javascript_access) ||
+      !create_params.client) {
+    return nullptr;
+  }
+  create_params.MaybeSetWindowInfo(window_info, /*allow_alloy_style=*/false,
+                                   /*allow_chrome_style=*/true);
+  create_params.popup_with_views_hosted_opener =
+      CefBrowserInfoManager::ShouldCreateViewsHostedPopup(
+          opener_host, /*use_default_browser_creation=*/false);
+  create_params.popup_with_alloy_style_opener = false;
+  auto platform_delegate = CefBrowserPlatformDelegate::Create(create_params);
+  CHECK(platform_delegate);
+  CHECK(platform_delegate->IsChromeStyle());
+
+  // 2. The tab's WebContents, as chrome::Navigate makes one for a new tab, and
+  // its browser host. OnPopupBrowserViewCreated gives the client the view.
+  Profile* profile = browser_->GetProfile();
+  content::WebContents::CreateParams contents_params(
+      profile, tab_util::GetSiteInstanceForNewTab(profile, url));
+  contents_params.initially_hidden = !active;
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(contents_params);
+  content::WebContents* new_contents = contents.get();
+  auto browser_host = ChromeBrowserDelegate::CreateBrowserHostForPopup(
+      new_contents, create_params.settings, create_params.client,
+      create_params.extra_info, std::move(platform_delegate),
+      /*is_devtools_popup=*/false, opener_host);
+
+  // 3. The popup Browser, which adds the WebContents to its tab strip (tab
+  // helpers, the tab id, tabs.onCreated), then the page.
+  browser_host->AddNewContents(std::move(contents), std::nullopt);
+  content::NavigationController::LoadURLParams load(url);
+  load.transition_type = ui::PAGE_TRANSITION_LINK;
+  new_contents->GetController().LoadURLWithParams(load);
+  return new_contents;
 }
 
