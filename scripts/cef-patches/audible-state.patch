+// Cra: Chromium's audible state (Chrome's tab speaker icon), which CEF has no
+// callback for. Delivered as a "Cra.audible" message from PID_BROWSER with the
+// new state, then whether the page's media session is one Chrome's global
+// media controls offer (MediaSessionImpl::IsControllable): a sound under 5 s,
+// such as a notification ding, or Web Audio alone is not.
+void CefBrowserContentsDelegate::OnAudioStateChanged(bool audible) {
+  auto c = client();
+  auto b = browser();
+  if (!c || !b) {
+    return;
+  }
+  auto* session = static_cast<content::MediaSessionImpl*>(
+      content::MediaSession::GetIfExists(web_contents()));
+  CefRefPtr<CefProcessMessage> message =
+      CefProcessMessage::Create("Cra.audible");
+  message->GetArgumentList()->SetBool(0, audible);
+  message->GetArgumentList()->SetBool(1, session && session->IsControllable());
+  c->OnProcessMessageReceived(b, b->GetMainFrame(), PID_BROWSER, message);
+}
+
+// Cra: whether the page uses the camera and the microphone, as Chrome's tab
+// recording indicator (MediaStreamCaptureIndicator) counts them. Delivered as a
+// "Cra.capture" message from PID_BROWSER with the camera and microphone states.
+void CefBrowserContentsDelegate::OnIsCapturingVideoChanged(
+    content::WebContents* web_contents,
+    bool is_capturing_video) {
+  if (web_contents == this->web_contents()) {
+    SendCaptureState();
+  }
+}
+
+void CefBrowserContentsDelegate::OnIsCapturingAudioChanged(
+    content::WebContents* web_contents,
+    bool is_capturing_audio) {
+  if (web_contents == this->web_contents()) {
+    SendCaptureState();
+  }
+}
+
+void CefBrowserContentsDelegate::SendCaptureState() {
+  auto c = client();
+  auto b = browser();
+  auto wc = web_contents();
+  if (!c || !b || !wc) {
+    return;
+  }
+  auto indicator =
+      MediaCaptureDevicesDispatcher::GetInstance()->GetMediaStreamCaptureIndicator();
+  CefRefPtr<CefProcessMessage> message =
+      CefProcessMessage::Create("Cra.capture");
+  message->GetArgumentList()->SetBool(0, indicator->IsCapturingVideo(wc));
+  message->GetArgumentList()->SetBool(1, indicator->IsCapturingAudio(wc));
+  c->OnProcessMessageReceived(b, b->GetMainFrame(), PID_BROWSER, message);
+}
