new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/core/canvas_interventions/cra_fingerprinting.h
@@ -0,0 +1,50 @@
+// Copyright 2026 The Cra Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_CANVAS_INTERVENTIONS_CRA_FINGERPRINTING_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_CANVAS_INTERVENTIONS_CRA_FINGERPRINTING_H_
+
+#include <cstdint>
+
+#include "base/containers/span.h"
+#include "base/memory/scoped_refptr.h"
+#include "third_party/blink/renderer/core/core_export.h"
+
+namespace blink {
+
+class ExecutionContext;
+class StaticBitmapImage;
+
+// Cra's fingerprinting protection (Settings > Privacy). The browser gives every
+// page a seed for its profile and launch (WebPreferences::
+// cra_fingerprinting_seed, 0 when off). The key mixes that seed with the
+// top-level site, so one site gets the same answers all session, while two
+// sites, two profiles or two launches get different ones.
+
+// 0 when the protection is off for |context|. Windows and dedicated workers
+// have a key; shared and service workers and worklets don't.
+CORE_EXPORT uint64_t CraFingerprintingKey(ExecutionContext* context);
+
+// Canvas readback (toDataURL, toBlob, convertToBlob, getImageData, WebGL
+// readPixels) carries Chromium's canvas noise: drawn pixels move by up to three
+// levels per channel, the same way for the same drawing.
+CORE_EXPORT scoped_refptr<StaticBitmapImage> CraNoiseImage(
+    ExecutionContext* context,
+    scoped_refptr<StaticBitmapImage> image);
+// |pixels| holds |width| x |height| tightly packed 8-bit RGBA or BGRA pixels.
+CORE_EXPORT void CraNoisePixels(ExecutionContext* context,
+                                base::span<uint8_t> pixels,
+                                int width,
+                                int height);
+
+// OfflineAudioContext output: each non-zero sample moves by at most a
+// hundred-thousandth of itself (about -100 dB), the same way for the same
+// rendering.
+CORE_EXPORT void CraNoiseAudio(ExecutionContext* context,
+                               base::span<float> samples,
+                               unsigned channel);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_CANVAS_INTERVENTIONS_CRA_FINGERPRINTING_H_
