+#include "third_party/blink/renderer/platform/weborigin/security_origin.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkImage.h"
+
+namespace blink {
+
+namespace {
+
+constexpr uint64_t kFnvOffset = 0xcbf29ce484222325ull;
+constexpr uint64_t kFnvPrime = 0x00000100000001b3ull;
+
+// The seed hashed with the top-level site (its registrable domain, or the host
+// for IP addresses and localhost).
+uint64_t KeyForSite(uint64_t seed, const SecurityOrigin* top) {
+  if (!seed || !top) {
+    return 0;
+  }
+  top = top->GetOriginOrPrecursorOriginIfOpaque();
+  String site = top->RegistrableDomain();
+  if (site.empty()) {
+    site = top->Host();
+  }
+  uint64_t hash = (kFnvOffset ^ seed) * kFnvPrime;
+  for (char c : site.Utf8()) {
+    hash ^= static_cast<uint8_t>(c);
+    hash *= kFnvPrime;
+  }
+  return hash ? hash : 1;
+}
+
+}  // namespace
+
+uint64_t CraFingerprintingKey(ExecutionContext* context) {
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    LocalFrame* frame = window->GetFrame();
+    if (!frame || !frame->GetSettings() || !frame->Top()) {
+      return 0;
+    }
+    const SecurityContext* top = frame->Top()->GetSecurityContext();
+    return KeyForSite(frame->GetSettings()->GetCraFingerprintingSeed(),
+                      top ? top->GetSecurityOrigin() : nullptr);
+  }
+  if (auto* worker = DynamicTo<WorkerGlobalScope>(context)) {
+    WorkerSettings* settings = worker->GetWorkerSettings();
+    return settings ? KeyForSite(settings->CraFingerprintingSeed(),
+                                 worker->top_level_frame_security_origin())
+                    : 0;
+  }
+  return 0;
+}
+
+scoped_refptr<StaticBitmapImage> CraNoiseImage(
+    ExecutionContext* context,
+    scoped_refptr<StaticBitmapImage> image) {
+  const uint64_t key = CraFingerprintingKey(context);
+  if (!key || !image) {
+    return image;
+  }
+  PaintImage paint_image = image->PaintImageForCurrentFrame();
+  const int width = paint_image.width();
+  const int height = paint_image.height();
+  if (width <= 0 || height <= 0) {
+    return image;
+  }
+  const SkImageInfo info = SkImageInfo::Make(
+      width, height, kRGBA_8888_SkColorType, kUnpremul_SkAlphaType,
+      paint_image.GetSkImageInfo().refColorSpace());
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(info) ||
+      !paint_image.readPixels(info, bitmap.getPixels(), bitmap.rowBytes(), 0,
+                              0)) {
+    return image;
+  }
+  // SAFETY: tryAllocPixels(info) allocated computeByteSize() bytes, rows of
+  // exactly width * 4 bytes.
+  NoisePixels(NoiseHash(NoiseToken(key)),
+              UNSAFE_BUFFERS(base::span(
+                  static_cast<uint8_t*>(bitmap.getPixels()),
+                  bitmap.computeByteSize())),
+              width, height);
+  bitmap.setImmutable();
+  return UnacceleratedStaticBitmapImage::Create(
+      SkImages::RasterFromBitmap(bitmap), image->Orientation());
+}
+
+void CraNoisePixels(ExecutionContext* context,
+                    base::span<uint8_t> pixels,
+                    int width,
+                    int height) {
+  if (width <= 0 || height <= 0 ||
+      pixels.size() != static_cast<size_t>(width) * height * 4) {
+    return;
+  }
+  const uint64_t key = CraFingerprintingKey(context);
+  if (!key) {
+    return;
+  }
+  NoisePixels(NoiseHash(NoiseToken(key)), pixels, width, height);
+}
+
+void CraNoiseAudio(ExecutionContext* context,
+                   base::span<float> samples,
+                   unsigned channel) {
+  const uint64_t key = CraFingerprintingKey(context);
+  if (!key) {
+    return;
+  }
+  for (size_t i = 0; i < samples.size(); ++i) {
+    const float sample = samples[i];
+    if (sample == 0.0f || !std::isfinite(sample)) {
+      continue;
+    }
+    NoiseHash hash{NoiseToken(key)};
+    hash.Update((uint64_t{channel} << 32) ^ i);
+    hash.Update(std::bit_cast<uint32_t>(sample));
+    const double scale = 1.0 + (hash.GetValueBelow(2001) - 1000) * 1e-8;
+    samples[i] = static_cast<float>(sample * scale);
+  }
+}
