+// Cra (GitHub #203): the CRX a Web Store install downloads (WebstoreInstaller,
+// from the store page's "Add to Chrome" or Cra.installFromWebStore) is Chrome's
+// own: it goes to the path WebstoreInstaller set, under the profile's "Webstore
+// Downloads", and CrxInstaller takes it from there. The client's download
+// handler never sees it, so no save panel asks where to put it and it never
+// lands in the Downloads folder; and one from a page with no CefBrowser
+// (Cra.installFromWebStore's) isn't cancelled.
+bool IsCraExtensionInstall(download::DownloadItem* item) {
+  return item->GetDownloadSource() ==
+         download::DownloadSource::EXTENSION_INSTALLER;
+}
+
+
+// Cra (GitHub #218): a download started where CEF made no browser, from
+// Chrome's own extension popup bubble, side panel or DevTools (a WebContents
+// with no CefBrowser) or from an extension's service worker through
+// chrome.downloads (no WebContents at all), was cancelled before the client's
+// download handler saw it. It goes to the page used last in the same profile
+// instead: the handler only needs a browser of that profile to pick the
+// folder, ask where to save and list the download.
+CefRefPtr<CefBrowserHostBase> CraBrowserForUnownedDownload(
+    download::DownloadItem* item,
+    content::WebContents* contents) {
+  if (!contents && item->GetDownloadSource() !=
+                       download::DownloadSource::EXTENSION_API) {
+    return nullptr;
+  }
+  content::BrowserContext* context =
+      content::DownloadItemUtils::GetBrowserContext(item);
+  if (!context) {
+    return nullptr;
+  }
+  CefRefPtr<CefBrowserHostBase> best;
+  base::TimeTicks best_active;
+  for (const auto& browser_info :
+       CefBrowserInfoManager::GetInstance()->GetBrowserInfoList()) {
+    auto browser = browser_info->browser();
+    if (!browser || browser->GetBrowserContext() != context) {
+      continue;
+    }
+    content::WebContents* web_contents = browser->GetWebContents();
+    if (!web_contents) {
+      continue;
+    }
+    base::TimeTicks active = web_contents->GetLastActiveTimeTicks();
+    if (!best || active > best_active) {
+      best = browser;
+      best_active = active;
+    }
+  }
+  return best;
+}
+
+}  // namespace
