+bool AutoPictureInPictureTabHelper::CraOnTabHidden() {
+  // Only what qualifies now (a call: the camera or microphone in use). A page
+  // that only plays sound waits for a Safe Browsing check in Chrome; the
+  // embedder asks its video instead.
+  if (!IsEligibleForAutoPictureInPicture(
+          /*should_record_blocking_metrics=*/false)) {
+    return false;
+  }
+  MaybeEnterAutoPictureInPicture();
+  return true;
+}
