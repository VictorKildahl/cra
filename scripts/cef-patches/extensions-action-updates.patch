+// Cra: forwards one profile's action changes to the handler.
+class ExtensionsHandler::ActionWatch
+    : public extensions::ExtensionActionDispatcher::Observer {
+ public:
+  ActionWatch(ExtensionsHandler* handler,
+              extensions::ExtensionActionDispatcher* dispatcher)
+      : handler_(handler) {
+    observation_.Observe(dispatcher);
+  }
+
+  bool IsWatching(extensions::ExtensionActionDispatcher* dispatcher) const {
+    return observation_.IsObservingSource(dispatcher);
+  }
+
+  void OnExtensionActionUpdated(
+      extensions::ExtensionAction* extension_action,
+      content::WebContents* web_contents,
+      content::BrowserContext* browser_context) override {
+    handler_->ReportAction(*extension_action, web_contents, browser_context);
+  }
+
+  void OnShuttingDown() override { observation_.Reset(); }
+
+ private:
+  raw_ptr<ExtensionsHandler> handler_;
+  base::ScopedObservation<extensions::ExtensionActionDispatcher,
+                          extensions::ExtensionActionDispatcher::Observer>
+      observation_{this};
+};
+
+protocol::DispatchResponse ExtensionsHandler::SetActionUpdatesEnabled(
+    bool enabled) {
+  if (!allow_loading_extensions_) {
+    return protocol::Response::ServerError("Method not available.");
+  }
+  if (!enabled) {
+    action_watches_.clear();
+    profile_manager_observation_.Reset();
+    reported_actions_.clear();
+    return protocol::Response::Success();
+  }
+  ProfileManager* profile_manager = g_browser_process->profile_manager();
+  if (!profile_manager) {
+    return protocol::Response::ServerError("No profile manager.");
+  }
+  if (!profile_manager_observation_.IsObserving()) {
+    profile_manager_observation_.Observe(profile_manager);
+  }
+  for (Profile* profile : profile_manager->GetLoadedProfiles()) {
+    WatchActions(profile);
+  }
+  return protocol::Response::Success();
+}
+
+void ExtensionsHandler::OnProfileAdded(Profile* profile) {
+  WatchActions(profile);
+}
+
+void ExtensionsHandler::OnProfileManagerDestroying() {
+  action_watches_.clear();
+  profile_manager_observation_.Reset();
+}
+
+// Observes `profile`'s actions and reports their tab-independent state.
+void ExtensionsHandler::WatchActions(Profile* profile) {
+  extensions::ExtensionActionDispatcher* dispatcher =
+      extensions::ExtensionActionDispatcher::Get(profile);
+  if (!dispatcher) {
+    return;
+  }
+  for (const auto& watch : action_watches_) {
+    if (watch->IsWatching(dispatcher)) {
+      return;
+    }
+  }
+  action_watches_.push_back(std::make_unique<ActionWatch>(this, dispatcher));
+  extensions::ExtensionActionManager* manager =
+      extensions::ExtensionActionManager::Get(profile);
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(profile);
+  if (!manager || !registry) {
+    return;
+  }
+  for (const auto& extension : registry->enabled_extensions()) {
+    if (extensions::ExtensionAction* action =
+            manager->GetExtensionAction(*extension)) {
+      ReportAction(*action, nullptr, profile);
+    }
+  }
+}
+
+// Reports what the extension set for a tab (only that tab's own values), or
+// with no `web_contents` its tab-independent values.
+void ExtensionsHandler::ReportAction(const extensions::ExtensionAction& action,
+                                     content::WebContents* web_contents,
+                                     content::BrowserContext* context) {
+  if (!frontend_ || !context) {
+    return;
+  }
+  const std::string profile = Profile::FromBrowserContext(context)
+                                  ->GetOriginalProfile()
+                                  ->GetBaseName()
+                                  .AsUTF8Unsafe();
+  int tab_id = extensions::ExtensionAction::kDefaultTabId;
+  std::optional<std::string> target_id;
+  if (web_contents) {
+    // Cra knows a tab by its page target; one DevTools never listed has none.
+    if (!content::DevToolsAgentHost::HasFor(web_contents)) {
+      return;
+    }
+    target_id =
+        content::DevToolsAgentHost::GetOrCreateFor(web_contents)->GetId();
+    tab_id = extensions::ExtensionTabUtil::GetTabId(web_contents);
+  }
+  const std::string key = profile + "/" + action.extension_id() + "/" +
+                          target_id.value_or(std::string());
+  if (web_contents && web_contents->IsBeingDestroyed()) {
+    reported_actions_.erase(key);
+    return;
+  }
+  const bool for_tab = target_id.has_value();
+  const std::string icon = PngDataUrl(
+      !for_tab || action.HasIcon(tab_id) ? action.GetExplicitlySetIcon(tab_id)
+                                         : action.GetDeclarativeIcon(tab_id));
+  const std::string title =
+      !for_tab || action.HasTitle(tab_id) ? action.GetTitle(tab_id) : "";
+  // A tab's badge is its own text, else the declarativeNetRequest action
+  // count when the extension asked for it.
+  const std::string badge_text =
+      !for_tab ? action.GetExplicitlySetBadgeText(tab_id)
+      : action.HasBadgeText(tab_id) || action.HasDNRActionCount(tab_id)
+          ? action.GetDisplayBadgeText(tab_id)
+          : "";
+  auto hex = [](SkColor color) {
+    return base::StringPrintf("#%02X%02X%02X%02X", SkColorGetR(color),
+                              SkColorGetG(color), SkColorGetB(color),
+                              SkColorGetA(color));
+  };
+  const std::string badge_color =
+      !for_tab || action.HasBadgeBackgroundColor(tab_id)
+          ? hex(action.GetBadgeBackgroundColor(tab_id))
+          : "";
+  const std::string badge_text_color =
+      !for_tab || action.HasBadgeTextColor(tab_id)
+          ? hex(action.GetBadgeTextColor(tab_id))
+          : "";
+  const std::string state = icon + "\n" + title + "\n" + badge_text + "\n" +
+                            badge_color + "\n" + badge_text_color;
+  const bool empty = icon.empty() && title.empty() && badge_text.empty() &&
+                     badge_color.empty() && badge_text_color.empty();
+  auto it = reported_actions_.find(key);
+  if (it == reported_actions_.end() ? (empty && for_tab) : it->second == state) {
+    return;
+  }
+  if (empty) {
+    reported_actions_.erase(key);
+  } else {
+    reported_actions_[key] = state;
+  }
+  frontend_->ActionUpdated(action.extension_id(), profile, icon, title,
+                           badge_text, badge_color, badge_text_color,
+                           std::move(target_id));
+}
 
