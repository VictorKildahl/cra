+// Cra: `image` as a PNG data: URL from its largest scale, empty when it has
+// none.
+std::string PngDataUrl(const gfx::Image& image) {
+  if (image.IsEmpty()) {
+    return std::string();
+  }
+  // image_reps() returns a copy: keep it alive while `best` points into it.
+  const std::vector<gfx::ImageSkiaRep> reps = image.AsImageSkia().image_reps();
+  const gfx::ImageSkiaRep* best = nullptr;
+  for (const gfx::ImageSkiaRep& rep : reps) {
+    if (!best || rep.scale() > best->scale()) {
+      best = &rep;
+    }
+  }
+  if (!best || best->GetBitmap().drawsNothing()) {
+    return std::string();
+  }
+  std::optional<std::vector<uint8_t>> png = gfx::PNGCodec::EncodeBGRASkBitmap(
+      best->GetBitmap(), /*discard_transparency=*/false);
+  return png ? "data:image/png;base64," + base::Base64Encode(*png)
+             : std::string();
+}
