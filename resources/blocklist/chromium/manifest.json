{
  "manifest_version": 3,
  "name": "Cra network filters",
  "description": "Applies the filter lists selected in Cra\u2019s Privacy settings.",
  "version": "1.2",
  "key": "",
  "permissions": [
    "declarativeNetRequest",
    "nativeMessaging",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "filters.js"
  }
}
