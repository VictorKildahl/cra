# promise: #168
# cra://open?url=…&space=<space id> (#168): the link opens as a tab in that space and the window
# goes there; background=1 adds it there and leaves the window where it is. An unknown id, or a
# space's title instead of its id, opens it where it did before, in the space in use. Each step
# reads which space the window shows (themeShown).
budget rss=600 stalls50=10
