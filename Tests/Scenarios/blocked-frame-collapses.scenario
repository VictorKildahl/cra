# An iframe from a listed ad or tracker domain, third-party to the page, is never loaded, and its
# frame collapses as Chrome does for a frame its blockers stop (no error page where the ad was).
# On the engine up to -10 the blocker never saw frames: Chromium proxies a navigation with no
# process, so the blocker found no page to compare with and let every ad frame through.
# omtrdc.net is on the bundled list; it and allowed.example (not listed) are the fixture server
# here, so the run needs no network.
# No & in a script: it ends the cra:// query.
budget rss=800 stalls50=30
arg --host-resolver-rules=MAP omtrdc.net 127.0.0.1, MAP *.omtrdc.net 127.0.0.1, MAP allowed.example 127.0.0.1
pace 0.5

cra://open?url=${PAGE}?n=frames
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)

# A frame from a third party that isn't listed loads and keeps its size.
cra://debug?cdp=Runtime.evaluate&params={"expression":"new Promise(r=>{const f=document.createElement('iframe');f.src='http://allowed.example:'+location.port+'/page.html?probe=allowed-frame';f.onload=()=>r('allowed frame:load '+f.offsetHeight);document.body.append(f)})","awaitPromise":true}
expect-log Cra cdp Runtime.evaluate .*"value":"allowed frame:load 1[0-9][0-9]"
expect-log GET /page\.html\?probe=allowed-frame

# A frame from a listed one: nothing is asked of its server and the frame takes no room.
cra://debug?cdp=Runtime.evaluate&params={"expression":"new Promise(r=>{const f=document.createElement('iframe');f.src='http://ads.tt.omtrdc.net:'+location.port+'/page.html?probe=blocked-frame';document.body.append(f);setTimeout(()=>r('blocked frame:height '+f.offsetHeight),3000)})","awaitPromise":true}
expect-log Cra cdp Runtime.evaluate .*"value":"blocked frame:height 0"
reject-log probe=blocked-frame
