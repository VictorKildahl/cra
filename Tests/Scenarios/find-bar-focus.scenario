# The find bar's keys: ⌘F puts them in the field every time, ⌘G and ⇧⌘G keep them there, Escape
# closes the bar and clears the page's matches, and ⌘F on an open bar selects the last search so
# typing replaces it. The keys are typed as a user types them: ⌘F to the page (which has the keyboard
# until the bar opens), the rest to the bar's panel. A copy in front, with real keys, keeps them the
# same way on a page that focuses a field or calls window.focus() on ⌘F/⌘G, and with matches in links
# and fields (17 Nov 2026, PR #473).
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true, "showToolbar": true}
cra://open?url=${PAGE}?n=find-focus
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
wait 1
cra://debug?key=f,3,1048576&page=1
wait 1
cra://debug?findBar=opened
expect-log findBar opened: visible=1 .*focused=1 selected=0 query=$
cra://debug?findQuery=page
wait 1
cra://debug?key=g,5,1048576&target=find
wait 0.5
cra://debug?findBar=next
expect-log findBar next: visible=1 .*focused=1 .*query=page$
cra://debug?key=G,5,1179648&target=find
wait 0.5
cra://debug?findBar=previous
expect-log findBar previous: visible=1 .*focused=1 .*query=page$
# Escape in the field: the bar goes, and so do the page's matches (its selection with them).
cra://debug?key=%1B,53,0&target=find
wait 1
cra://debug?findBar=escaped
expect-log findBar escaped: visible=0
cra://debug?cdp=Runtime.evaluate&params={"expression":"'selection:'+getSelection().toString().length"}
expect-log Cra cdp Runtime.evaluate .*"value":"selection:0"
# ⌘F again, from the page: the last search, all of it selected.
cra://debug?key=f,3,1048576&page=1
wait 1
cra://debug?findBar=reopened
expect-log findBar reopened: visible=1 .*focused=1 selected=1 query=page$
# ⌘F on the open bar, from its field: the keys and the selection again.
cra://debug?findQuery=pag
wait 0.5
cra://debug?key=f,3,1048576&target=find
wait 1
cra://debug?findBar=again
expect-log findBar again: visible=1 .*focused=1 selected=1 query=pag$
# And from the page, once it has the keys again.
cra://debug?key=f,3,1048576&page=1
wait 1
cra://debug?findBar=fromPage
expect-log findBar fromPage: visible=1 .*focused=1 selected=1 query=pag$
