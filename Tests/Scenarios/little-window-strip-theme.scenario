# promise: #549
# The Little Window's strip doesn't take the space's theme in any space (#549 asked for a green-teal
# space's theme on it). Since PR #813 (#810, Victor's call, 26 Nov) it is painted in the page's colour,
# white on this fixture page, where Little Arc drew one dark gradient. Only the space's name in
# "Open in <Space>" takes the space's colour, darkened to read on the strip (CraCore LittleStripTones).
# These colours were not checked until scenario.sh stopped cutting lines at their first #.
budget rss=700 stalls50=20
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true, "defaultLinkDestination": {"littleWindow": {}}}
seed sidebar.json {"version":1,"spaceOrder":["A0000000-0000-0000-0000-000000000001","A0000000-0000-0000-0000-000000000002"],"spaces":[{"id":"A0000000-0000-0000-0000-000000000001","title":"Work","emoji":"🚀","favoritesContainerID":"C0000000-0000-0000-0000-000000000011","pinnedContainerID":"C0000000-0000-0000-0000-000000000012","todayContainerID":"C0000000-0000-0000-0000-000000000013","createdAt":"2026-11-06T08:00:00Z","theme":{"colors":["#6E9A72","#2E7A78"],"intensity":0.7,"noise":0.1,"appearance":"light"}},{"id":"A0000000-0000-0000-0000-000000000002","title":"Home","emoji":"🏠","favoritesContainerID":"C0000000-0000-0000-0000-000000000021","pinnedContainerID":"C0000000-0000-0000-0000-000000000022","todayContainerID":"C0000000-0000-0000-0000-000000000023","createdAt":"2026-11-06T08:00:00Z","theme":{"colors":["#F8D558"],"intensity":0.6,"noise":0.1,"appearance":"light"}}],"items":[{"id":"C0000000-0000-0000-0000-000000000011","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"favorites":{"spaceID":"A0000000-0000-0000-0000-000000000001"}}}}},{"id":"C0000000-0000-0000-0000-000000000012","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"pinned":{"spaceID":"A0000000-0000-0000-0000-000000000001"}}}}},{"id":"C0000000-0000-0000-0000-000000000013","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"today":{"spaceID":"A0000000-0000-0000-0000-000000000001"}}}}},{"id":"C0000000-0000-0000-0000-000000000021","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"favorites":{"spaceID":"A0000000-0000-0000-0000-000000000002"}}}}},{"id":"C0000000-0000-0000-0000-000000000022","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"pinned":{"spaceID":"A0000000-0000-0000-0000-000000000002"}}}}},{"id":"C0000000-0000-0000-0000-000000000023","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"today":{"spaceID":"A0000000-0000-0000-0000-000000000002"}}}}}]}
pace 0.5

# Opened from Work, a green-teal space: the page's white strip, and "Work" in its green.
cra://debug?externalURL=${PAGE}?n=work
wait 2
cra://debug?littleShown=work
expect-log little shown work: windows=1 space=Work .* gradient=#FFFFFF-#FFFFFF name=#577E5B padlock=

# Picked Home, a yellow space: the same strip, and "Home" in its yellow.
cra://debug?littleCommit=home
expect-log little commit home: Switch to Home
cra://debug?littleShown=home
expect-log little shown home: windows=1 space=Home .* gradient=#FFFFFF-#FFFFFF name=#907206 padlock=
