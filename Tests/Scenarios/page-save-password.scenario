# promise: #574
# After a sign-in with a new password, Chrome offers to save it ("Save password?") on Cra's window, big
# enough to answer. Chrome anchors that bubble to its (never seen) Browser window, a 1 pt strip along the
# top of Cra's window since 0.1.49 (#346); it held on engine -25 (#574), and this keeps it so.
budget rss=900 stalls50=30
pace 0.5
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true}
cra://debug?windowSize=1200x800
cra://open?url=${ORIGIN}/sign-in.html?n=form
expect-log GET /sign-in.html\?n=form
wait 2
cra://debug?cdp=Runtime.evaluate&params={"expression":"(user.focus(),'user focused')","userGesture":true}
expect-log "value":"user focused"
cra://debug?cdp=Input.insertText&params={"text":"ada"}
cra://debug?cdp=Runtime.evaluate&params={"expression":"(password.focus(),'password focused')","userGesture":true}
expect-log "value":"password focused"
cra://debug?cdp=Input.insertText&params={"text":"correct-horse-battery"}
cra://debug?cdp=Runtime.evaluate&params={"expression":"(form.requestSubmit(),'signed in')","userGesture":true}
expect-log GET /page.html\?signed=1
wait 3
cra://debug?pageDialogs=save
expect-log page dialog save: chrome [0-9]+x[0-9]+ at=(page|window) front=1 .*buttons=.*Save fields=2
reject-log fault:
