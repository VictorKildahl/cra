# promise: #706
# With the address in the sidebar, a Peek that goes any way other than Esc or its close button (Expand, Add to
# Split, the page's own window.close()) left the sidebar's address field on its page for good: every tab showed
# the Peek's address, ← → ↻ acted on nothing, and hovering the field showed no extensions or site controls. The
# Peek ends in windowWillClose, while its window is still visible and it isn't marked as closing, so it still
# counted as the Peek in front (#648's PeekAddress). Esc is covered by peek-sidebar-address.
budget rss=900 stalls50=40
pace 0.5
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true, "showToolbar": false, "peekInEveryTab": true}

cra://open?url=${PAGE}?n=under
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
wait 1
cra://debug?sidebarAddress=start
expect-log sidebar address start: url=\S*n=under back=0 forward=0

# Expanded: the Peek's page is a tab of its own, and the field is that tab's.
cra://debug?cdp=Runtime.evaluate&params={"expression":"String(!!window.open('${PAGE}?n=peek'))","userGesture":true}
expect-log peek: from
wait 1.5
cra://debug?sidebarAddress=peek
expect-log sidebar address peek: url=\S*n=peek
cra://debug?peekExpand=plain
expect-log peek expand plain: selected=\S+n=peek
wait 1.5
cra://debug?peeks=expanded
expect-log Cra peeks expanded: none$

# Back on the first tab, the field is that tab's, not the expanded Peek's.
cra://action/recentTab
wait 1.5
cra://debug?sidebarAddress=switched
expect-log sidebar address switched: url=\S*n=under back=0 forward=0

# A Peek its own page closes (window.close()): the field is the tab's again.
cra://debug?cdp=Runtime.evaluate&params={"expression":"String(!!window.open('${PAGE}?n=closes'))","userGesture":true}
wait 1.5
cra://debug?sidebarAddress=second
expect-log sidebar address second: url=\S*n=closes
cra://debug?target=little&cdp=Runtime.evaluate&params={"expression":"setTimeout(()=>window.close(),100);'ok'","returnByValue":true,"userGesture":true}
wait 1.5
cra://debug?peeks=closed
expect-log Cra peeks closed: none$
cra://debug?sidebarAddress=closed
expect-log sidebar address closed: url=\S*n=under back=0 forward=0
