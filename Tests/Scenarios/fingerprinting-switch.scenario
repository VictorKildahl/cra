# Fingerprinting protection is off by default: the fingerprint fixture reads back exactly what it
# drew, from a 2D canvas, toDataURL, WebGL, offline audio and an OffscreenCanvas in a worker.
# Switched on while the page is open, the next readback carries the noise without a reload
# (Chrome pushes the pref to open pages); switched off again, it reads back exactly.
budget rss=700 stalls50=10
cra://open?url=${PAGE}/../fingerprint.html
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
wait 1
cra://debug?cdp=Runtime.evaluate&params={"expression":"fingerprint().then(r=>'default '+r)","awaitPromise":true}
expect-log Cra cdp Runtime.evaluate .*"value":"default fp:2d=0/0,same png=0/0 gl=0/0 audio=0/faint cores=[0-9]+ worker=[0-9]+/0"
cra://debug?fingerprinting=on
wait 1
cra://debug?cdp=Runtime.evaluate&params={"expression":"fingerprint().then(r=>'on '+r)","awaitPromise":true}
expect-log Cra cdp Runtime.evaluate .*"value":"on fp:2d=[1-9][0-9]*/[1-3],same png=[1-9][0-9]*/[0-9]+ gl=[1-9][0-9]*/[1-3] audio=[1-9][0-9]*/faint cores=8 worker=8/[1-9][0-9]*"
cra://debug?fingerprinting=off
wait 1
cra://debug?cdp=Runtime.evaluate&params={"expression":"fingerprint().then(r=>'off '+r)","awaitPromise":true}
expect-log Cra cdp Runtime.evaluate .*"value":"off fp:2d=0/0,same png=0/0 gl=0/0 audio=0/faint cores=[0-9]+ worker=[0-9]+/0"
