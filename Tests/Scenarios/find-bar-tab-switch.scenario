# Arc closes the find bar (⌘F) when you switch tabs; Cra kept it open over the next tab's page.
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true}
cra://open?url=${PAGE}?n=find-a
wait 2
cra://open?url=${PAGE}?n=find-b
wait 2
cra://action/find
wait 1
cra://debug?findBar=open
expect-log findBar open: visible=1
cra://action/previousTab
wait 1
cra://debug?findBar=switched
expect-log findBar switched: visible=0
# Switching back doesn't bring it back, as in Arc.
cra://action/nextTab
wait 1
cra://debug?findBar=back
expect-log findBar back: visible=0
