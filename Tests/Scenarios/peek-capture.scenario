budget rss=900 stalls50=60
pace 0.5
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true, "showToolbar": false, "peekInEveryTab": true}

cra://open?url=${PAGE}?n=under
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
wait 1
cra://debug?cdp=Runtime.evaluate&params={"expression":"String(!!window.open('${PAGE}?n=peek'))","userGesture":true}
expect-log peek: from
wait 1.5
cra://action/capturePage
wait 1
cra://debug?captureShown=peek
expect-log capture peek: open parent=peek visible=1 source=\S+n=peek$
cra://debug?peeks=capturing
expect-log Cra peeks capturing: shown \S+n=peek$
cra://debug?peekShown=capturing
expect-log Cra peek shown capturing: veiled=1 alpha=0\.28

cra://action/capturePage
cra://debug?captureShown=cancelled
expect-log capture cancelled: closed$
cra://debug?peeks=cancelled
expect-log Cra peeks cancelled: shown \S+n=peek$

cra://action/capturePage
wait 1
cra://debug?captureShown=again
expect-log capture again: open parent=peek visible=1 source=\S+n=peek$
cra://action/capturePage
cra://action/closeTab
wait 1
cra://action/capturePage
wait 1
cra://debug?captureShown=main
expect-log capture main: open parent=main visible=1 source=\S+n=under$
cra://action/capturePage
cra://debug?captureShown=finished
expect-log capture finished: closed$
