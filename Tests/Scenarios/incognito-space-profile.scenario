# promise: #620
# Incognito from a space with a profile of its own is that profile's incognito, as each Chrome profile has its own:
# chrome://version in the new window names the profile's folder. Cra put every incognito window in Default's, so a
# profile's extensions (uBlock Origin Lite, GoFullPage) found nothing they were allowed on there (GitHub #620).
budget rss=800 stalls50=10
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true, "showToolbar": false}
