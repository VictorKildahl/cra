# promise: #469
# A link that opens in a new tab in front (target=_blank, a page's window.open such as Google
# Sheets' links) draws its page. 0.1.44 left such tabs blank (GitHub #469): Cra showed the tab before
# its card was there, so the page never went in, and Chrome had already put the page in front in its own
# never-shown window, where it went on drawing.
budget rss=900 stalls50=30
pace 0.5
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true, "showToolbar": false}
cra://debug?windowSize=1280x800
cra://open?url=${PAGE}?n=source
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
wait 2
cra://debug?pageDrawn=source
expect-log page drawn source: inCard=1 drawn=1

# A target=_blank link: a new tab in front.
cra://debug?cdp=Runtime.evaluate&params={"expression":"(a=>(a.href='${PAGE}?n=blank',a.target='_blank',document.body.append(a),a.click(),'clicked'))(document.createElement('a'))","userGesture":true}
expect-log GET /page\.html\?n=blank
wait 3
cra://debug?cdp=Runtime.evaluate&params={"expression":"new Promise(r=>{let n=0;const t0=performance.now();const f=()=>{n++;if(performance.now()-t0<1000)requestAnimationFrame(f);else r('front tab '+location.search+' '+document.visibilityState+' frames:'+n)};requestAnimationFrame(f);setTimeout(()=>r('front tab '+location.search+' '+document.visibilityState+' frames:0'),3000)})","awaitPromise":true}
expect-log front tab \?n=blank visible frames:[1-9]
cra://debug?pageDrawn=blank
expect-log page drawn blank: inCard=1 drawn=1

# A page's own window.open, from a click.
cra://debug?cdp=Runtime.evaluate&params={"expression":"String(!!window.open('${PAGE}?n=opened'))","userGesture":true}
expect-log GET /page\.html\?n=opened
wait 3
cra://debug?cdp=Runtime.evaluate&params={"expression":"new Promise(r=>{let n=0;const t0=performance.now();const f=()=>{n++;if(performance.now()-t0<1000)requestAnimationFrame(f);else r('opened tab '+location.search+' '+document.visibilityState+' frames:'+n)};requestAnimationFrame(f);setTimeout(()=>r('opened tab '+location.search+' '+document.visibilityState+' frames:0'),3000)})","awaitPromise":true}
expect-log opened tab \?n=opened visible frames:[1-9]
cra://debug?pageDrawn=opened
expect-log page drawn opened: inCard=1 drawn=1
