# A pinned tab that hasn't loaded since launch (restored, imported) shows a globe until its site's icon
# comes: the row on screen asks the site's home page and then /favicon.ico in the background, without the
# tab's page ever loading (PR #760). Here the site is the fixture server, a local site that may ask itself.
# What gets stored, and what never gets asked, is in scripts/test-site-icons.sh and SiteIconQueueTests.
port 47141
budget rss=600 stalls50=10
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true}
seed sidebar.json {"version":1,"spaceOrder":["A0000000-0000-0000-0000-000000000001"],"spaces":[{"id":"A0000000-0000-0000-0000-000000000001","title":"Home","emoji":"🏠","theme":{"colors":["#8389FF","#8389FF"],"intensity":0.5,"noise":0,"appearance":"light","accent":"#8389FF","solid":true,"key":["#8389FF"]},"favoritesContainerID":"C0000000-0000-0000-0000-000000000011","pinnedContainerID":"C0000000-0000-0000-0000-000000000012","todayContainerID":"C0000000-0000-0000-0000-000000000013","createdAt":"2026-11-25T08:00:00Z"}],"items":[{"id":"C0000000-0000-0000-0000-000000000011","children":[],"isUnread":false,"createdAt":"2026-11-25T08:00:00Z","data":{"container":{"_0":{"favorites":{"spaceID":"A0000000-0000-0000-0000-000000000001"}}}}},{"id":"C0000000-0000-0000-0000-000000000012","children":["E0000000-0000-0000-0000-000000000012"],"isUnread":false,"createdAt":"2026-11-25T08:00:00Z","data":{"container":{"_0":{"pinned":{"spaceID":"A0000000-0000-0000-0000-000000000001"}}}}},{"id":"E0000000-0000-0000-0000-000000000012","parentID":"C0000000-0000-0000-0000-000000000012","children":[],"isUnread":false,"createdAt":"2026-11-25T08:00:00Z","data":{"tab":{"_0":{"url":"http://127.0.0.1:47141/page.html?n=never-loaded","savedTitle":"Never loaded"}}}},{"id":"C0000000-0000-0000-0000-000000000013","children":[],"isUnread":false,"createdAt":"2026-11-25T08:00:00Z","data":{"container":{"_0":{"today":{"spaceID":"A0000000-0000-0000-0000-000000000001"}}}}}]}
wait 4
expect-log "GET / HTTP/1\.1"
expect-log "GET /favicon\.ico HTTP/1\.1"
reject-log GET /page\.html\?n=never-loaded
cra://debug?checkStore=1
