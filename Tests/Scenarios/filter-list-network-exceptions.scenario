# A single URL can be a blocked fetch, a permitted image, or an allowed fetch
# on one specific site. The local HTTP server observes the successful requests.
port 47136
pace 0.5
budget rss=800 stalls50=30
arg --host-resolver-rules=MAP assets.fixture.example 127.0.0.1, MAP reader.example 127.0.0.1, MAP other.example 127.0.0.1
seed sidebar.json {"version":1,"spaceOrder":["A0000000-0000-0000-0000-000000000001","A0000000-0000-0000-0000-000000000002"],"spaces":[{"id":"A0000000-0000-0000-0000-000000000001","title":"Personal","emoji":"🏠","favoritesContainerID":"C0000000-0000-0000-0000-000000000011","pinnedContainerID":"C0000000-0000-0000-0000-000000000012","todayContainerID":"C0000000-0000-0000-0000-000000000013","createdAt":"2026-11-06T08:00:00Z","theme":{"colors":["#8389FF","#8389FF"],"intensity":0.5,"noise":0,"appearance":"light","accent":"#8389FF","solid":true,"key":["#8389FF"]}},{"id":"A0000000-0000-0000-0000-000000000002","title":"Random","emoji":"🎲","favoritesContainerID":"C0000000-0000-0000-0000-000000000021","pinnedContainerID":"C0000000-0000-0000-0000-000000000022","todayContainerID":"C0000000-0000-0000-0000-000000000023","createdAt":"2026-11-06T08:00:00Z","profileID":"B0000000-0000-0000-0000-000000000001","theme":{"colors":["#8389FF","#8389FF"],"intensity":0.5,"noise":0,"appearance":"light","accent":"#8389FF","solid":true,"key":["#8389FF"]}}],"profiles":[{"id":"B0000000-0000-0000-0000-000000000001","name":"Hobbies"}],"items":[{"id":"C0000000-0000-0000-0000-000000000011","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"favorites":{"spaceID":"A0000000-0000-0000-0000-000000000001"}}}}},{"id":"C0000000-0000-0000-0000-000000000012","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"pinned":{"spaceID":"A0000000-0000-0000-0000-000000000001"}}}}},{"id":"C0000000-0000-0000-0000-000000000013","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"today":{"spaceID":"A0000000-0000-0000-0000-000000000001"}}}}},{"id":"C0000000-0000-0000-0000-000000000021","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"favorites":{"spaceID":"A0000000-0000-0000-0000-000000000002"}}}}},{"id":"C0000000-0000-0000-0000-000000000022","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"pinned":{"spaceID":"A0000000-0000-0000-0000-000000000002"}}}}},{"id":"C0000000-0000-0000-0000-000000000023","children":[],"isUnread":false,"createdAt":"2026-11-06T08:00:00Z","data":{"container":{"_0":{"today":{"spaceID":"A0000000-0000-0000-0000-000000000002"}}}}}]}
cra://open?url=http://other.example:47136/page.html
expect-log loaded other\.example \(HTTP 200\)
cra://debug?blockLists=http://127.0.0.1:47136/network-filter-test.txt
expect-log GET /network-filter-test\.txt
expect-log block lists: [0-9]+ domains, 1 added list
expect-log network filter revision active:
cra://debug?cdp=Runtime.evaluate&params={"expression":"fetch('http://assets.fixture.example:47136/icon-blue.png?blocked',{mode:'no-cors'}).then(()=>'sent',e=>'blocked:'+e.name)","awaitPromise":true}
expect-log Cra cdp Runtime.evaluate .*"value":"blocked:TypeError"
reject-log GET /icon-blue\.png\?blocked
cra://debug?cdp=Runtime.evaluate&params={"expression":"new Promise(r=>{const i=new Image();i.onload=()=>r('image:'+i.naturalWidth);i.onerror=()=>r('failed');i.src='http://assets.fixture.example:47136/icon-blue.png?image'})","awaitPromise":true}
expect-log Cra cdp Runtime.evaluate .*"value":"image:[1-9]
expect-log GET /icon-blue\.png\?image
cra://open?url=http://reader.example:47136/page.html
expect-log loaded reader\.example \(HTTP 200\)
cra://debug?cdp=Runtime.evaluate&params={"expression":"fetch('http://assets.fixture.example:47136/icon-blue.png?allowed',{mode:'no-cors'}).then(()=>'allowed',e=>e.name)","awaitPromise":true}
expect-log Cra cdp Runtime.evaluate .*"value":"allowed"
expect-log GET /icon-blue\.png\?allowed

# The same ID-independent rule must apply in a named profile's first private window.
cra://open?url=http://other.example:47136/page.html?named&space=A0000000-0000-0000-0000-000000000002
expect-log GET /page\.html\?named
cra://debug?incognitoWindow=http://other.example:47136/page.html?private
expect-log GET /page\.html\?private
cra://debug?cdp=Runtime.evaluate&params={"expression":"fetch('http://assets.fixture.example:47136/icon-blue.png?privatedeny',{mode:'no-cors'}).then(()=>'leak',e=>'private-blocked:'+e.name)","awaitPromise":true}
expect-log Cra cdp Runtime.evaluate .*"value":"private-blocked:TypeError"
reject-log GET /icon-blue\.png\?privatedeny
cra://debug?cdp=Runtime.evaluate&params={"expression":"new Promise(r=>{const i=new Image();i.onload=()=>r('private-image:'+i.naturalWidth);i.onerror=()=>r('failed');i.src='http://assets.fixture.example:47136/icon-blue.png?privateimage'})","awaitPromise":true}
expect-log Cra cdp Runtime.evaluate .*"value":"private-image:[1-9]
expect-log GET /icon-blue\.png\?privateimage
