pace 0.5

# Ten spaces: the list stops at 350 and scrolls.
cra://debug?externalURL=${PAGE}?n=ten
wait 2
cra://debug?littleShown=ten
expect-log little shown ten: windows=1 .* menuButton=1
cra://debug?littlePopup=ten
expect-log little popup ten: open=1 rows=10 listHeight=350 height=396 noResults=0 scrolls=1

# A search leaves two ("Space 1" and "Space 10"): two rows, no scrolling, the menu shrinks to fit.
cra://debug?littlePopup=two&type=Space%201
expect-log little popup two: open=1 rows=2 listHeight=92 height=138 noResults=0 scrolls=0

# One that matches nothing: "No results", in a row's height.
cra://debug?littlePopup=none&type=zzz
expect-log little popup none: open=1 rows=0 listHeight=46 height=92 noResults=1 scrolls=0
