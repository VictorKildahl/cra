# promise: #544
# A folder's preview lit rows the pointer wasn't on (#544). Each row tracked the pointer itself, and when
# the list scrolled under a pointer that stayed put, AppKit moved their tracking areas without sending
# the row that had it an exit: its highlight stayed, and the next row under the pointer lit too. Now the
# preview works out the one row under the pointer whenever the pointer moves or the list scrolls.
budget rss=600
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true, "showToolbar": false}
