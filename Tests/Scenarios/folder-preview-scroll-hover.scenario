cra://debug?windowSize=1280x800
wait 2
cra://debug?folderPreview=F0000000-0000-0000-0000-000000000001
wait 1
cra://debug?folderPreviewPointer=2
cra://debug?folderPreviewLit=resting
expect-log Cra folderPreview resting: lit=2 top=0$
# The list scrolls three rows under the still pointer: the row now under it is the only one lit.
cra://debug?folderPreviewScroll=3
wait 0.5
cra://debug?folderPreviewLit=scrolled
expect-log Cra folderPreview scrolled: lit=5 top=135$
cra://debug?folderPreviewScroll=1
wait 0.5
cra://debug?folderPreviewLit=back
expect-log Cra folderPreview back: lit=3 top=45$
cra://debug?folderPreview=close
