# promise: #431
# Settings opened from a full-screen window opens over it, on its Space, as Arc's and Safari's do: macOS doesn't
# swipe back to a Desktop to show it. It is opened and closed on the Desktop first, so a Settings window macOS
# has already placed on a Space comes along too. It takes over a Space, so it runs only with CRA_SCENARIO_SCREEN=1.
requires screen
budget rss=600 stalls50=10
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true}
cra://open?url=${PAGE}?n=full
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
wait 1
cra://action/settings
wait 1
cra://debug?windowState=desktop
expect-log window state desktop: settings visible=1 front=1
cra://action/closeTab
wait 1
cra://debug?fullscreen=1
wait 3
cra://action/settings
wait 2
cra://debug?windowState=fullscreen
expect-log window state fullscreen: main0 fullscreen=1 visible=1 onSpace=1
expect-log window state fullscreen: settings visible=1 front=1 .* onSpace=1 auxiliary=1 movesToActiveSpace=1
cra://action/closeTab
wait 1
cra://debug?windowState=closed
expect-log window state closed: main0 fullscreen=1 visible=1 onSpace=1
expect-log window state closed: settings visible=0
cra://debug?fullscreen=0
wait 3
