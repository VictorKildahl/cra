cra://debug?systemAppearance=light
wait 1
cra://debug?themeShown=auto-light
expect-log Cra theme shown auto-light: space=Auto follows=1 theme=light shell=light sidebar=light
cra://debug?systemAppearance=dark
wait 1
cra://debug?themeShown=auto-dark
expect-log Cra theme shown auto-dark: space=Auto follows=1 theme=dark shell=dark sidebar=dark
snapshot SpaceHeaderView auto-theme-header-dark
cra://debug?systemAppearance=light
wait 1
cra://debug?themeShown=auto-light-again
expect-log Cra theme shown auto-light-again: space=Auto follows=1 theme=light shell=light sidebar=light
snapshot SpaceHeaderView auto-theme-header-light
cra://action/space2
wait 1
cra://debug?systemAppearance=dark
wait 1
