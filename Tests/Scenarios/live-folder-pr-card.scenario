# Snapshot card on a live PR (even its /files tab), with no network grant so the hover
# checks request fails soft through the real sandbox. Background: no folder refresh.
budget rss=700 stalls50=10
seed settings.json {"hasSeenImportPrompt":true,"toolbarDefaultMigrated":true,"pullRequestPreviews":true}
