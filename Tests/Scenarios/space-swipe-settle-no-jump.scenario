# promise: #613
# A swipe between spaces settles from where the fingers left the strip. The release switches the space, which
# can hold the main thread for a frame or more; the settle's spring was timed from the release, so it had run
# that long when it first drew, and the strip stood still for a frame and then jumped (25 to 46 points in one
# frame on the reporter's recording, where Arc's sidebar picks up speed over three). Timed from its first frame
# (SettleClock) it goes one frame's way, however long the release took.
budget rss=700 stalls50=10
