# Arc's Picture in Picture window has a scrubber along the bottom: it shows how far the video is,
# and a press on it seeks. Cra's window had only the ±15 s skips (reported by a user, 11 Nov). Here
# a 4 s clip is in Picture in Picture, paused: the scrubber shows, and a press half way along puts
# the video at 2 s. A stream has no end, so its window has no scrubber. (No pointer: the test copy
# runs in the background, so the press is handed to the scrubber.)
cra://open?url=file://${FIXTURES}/Pages/media.html
expect-log loaded file:
wait 2
cra://debug?cdp=Runtime.evaluate&params={"expression":"document.getElementById('v').requestPictureInPicture().then(()=>'pip:open')","awaitPromise":true,"userGesture":true}
expect-log Cra cdp Runtime.evaluate .*"value":"pip:open"
wait 1
cra://debug?pip=clip
expect-log Cra pip clip: windows=1 .* scrub=1 at=0
cra://debug?pipSeek=0.5
wait 1
cra://debug?cdp=Runtime.evaluate&params={"expression":"'at:'+document.getElementById('v').currentTime.toFixed(1)"}
expect-log Cra cdp Runtime.evaluate .*"value":"at:2\.0"
cra://debug?pip=half
expect-log Cra pip half: windows=1 .* scrub=1 at=50
cra://debug?cdp=Runtime.evaluate&params={"expression":"document.exitPictureInPicture().then(()=>'pip:closed')","awaitPromise":true,"userGesture":true}
expect-log Cra cdp Runtime.evaluate .*"value":"pip:closed"
cra://open?url=file://${FIXTURES}/Pages/video.html
wait 3
cra://debug?cdp=Runtime.evaluate&params={"expression":"document.getElementById('v').requestPictureInPicture().then(()=>'pip:stream')","awaitPromise":true,"userGesture":true}
expect-log Cra cdp Runtime.evaluate .*"value":"pip:stream"
wait 1
cra://debug?pip=stream
expect-log Cra pip stream: windows=1 .* scrub=0
