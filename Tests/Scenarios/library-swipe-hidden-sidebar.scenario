# Arc 1.173.1: with the sidebar hidden and out over the page, a swipe on the first space brings the
# Library in docked. It slides in under the floating sidebar and pushes the page before it, the
# floating sidebar goes back out two points for the page's three, and leaving the Library by a
# swipe ends on the hidden sidebar again. Cra took no swipe toward the Library there.
budget rss=700 stalls50=10
