# web-features: a page that takes the pointer (a 3D model viewer, a browser game: requestPointerLock). The lock
# has to take, and Esc has to give the pointer back whatever the page does: Chrome's exclusive access takes Esc
# before Cra's own keys (cra-keys.patch), and nothing may change that order. The page can let go itself too.
# Chrome's "Press Esc to show your cursor" notice hangs on its never-seen Browser window (#346) and isn't seen:
# docs/web-features.md, "Known". It takes the screen: the lock holds the real pointer for a moment.
requires screen
# Cra has to come to the front to have a key window; a page only takes focus in a key window.
env CRA_TEST_BACKGROUND=0
budget rss=900 stalls50=40
pace 0.5
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true, "showToolbar": false}
cra://debug?windowSize=1200x800
cra://open?url=${ORIGIN}/features.html?n=lock
expect-log GET /features.html\?n=lock
wait 2
cra://debug?activate=1
wait 1
cra://debug?clickAt=760,500
wait 1
cra://debug?cdp=Runtime.evaluate&params={"expression":"(document.getElementById('lock').requestPointerLock(),'lock asked')","userGesture":true}
expect-log "value":"lock asked"
wait 1
cra://debug?cdp=Runtime.evaluate&params={"expression":"'lock '+said.join(',')"}
expect-log "value":"lock pointerlock:on"
# Esc, as the keyboard sends it to the page: the pointer comes back, and the page never sees the key.
cra://debug?key=%1B,53,0&page=1
wait 1
cra://debug?cdp=Runtime.evaluate&params={"expression":"'after escape '+said.join(',')"}
expect-log "value":"after escape pointerlock:on,pointerlock:off"
# The page can take it again and let go itself.
cra://debug?cdp=Runtime.evaluate&params={"expression":"(said.length=0,document.getElementById('lock').requestPointerLock(),'lock again')","userGesture":true}
wait 1
cra://debug?cdp=Runtime.evaluate&params={"expression":"(document.exitPointerLock(),'unlocking')"}
wait 1
cra://debug?cdp=Runtime.evaluate&params={"expression":"'unlocked '+said.join(',')"}
expect-log "value":"unlocked pointerlock:on,pointerlock:off"
reject-log fault:
