# promise: #521
# A GitHub live folder whose organisation wants single sign-on shows Arc's key on its row, with
# "Login with SSO to unlock this folder", and a click on it opens that organisation's SSO page; one
# GitHub signed out of shows the warning triangle and "Sign back in to GitHub.", and a click opens
# the sign-in (Arc 1.172's ListHeaderCellView; Cra drew the triangle for both). Both folders are
# seeded with the plug-in's last answer, their sign-in pages on the fixture server (port 47521);
# Cra stays in the background, so neither refreshes.
budget rss=600
port 47521
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true, "showToolbar": false, "commandBarCurrentSpaceOnly": true}
seed sidebar.json {"version": 1, "spaceOrder": ["A0000000-0000-0000-0000-000000000001", "A0000000-0000-0000-0000-000000000002"], "spaces": [{"id": "A0000000-0000-0000-0000-000000000001", "title": "Home", "emoji": "\ud83c\udfe0", "theme": {"colors": ["#8389FF", "#8389FF"], "intensity": 0.5, "noise": 0, "appearance": "light", "accent": "#8389FF", "solid": true, "key": ["#8389FF"]}, "favoritesContainerID": "C0000000-0000-0000-0000-000000000011", "pinnedContainerID": "C0000000-0000-0000-0000-000000000012", "todayContainerID": "C0000000-0000-0000-0000-000000000013", "createdAt": "2026-11-06T08:00:00Z"}, {"id": "A0000000-0000-0000-0000-000000000002", "title": "Work", "emoji": "\ud83d\udcbc", "theme": {"colors": ["#8389FF", "#8389FF"], "intensity": 0.5, "noise": 0, "appearance": "light", "accent": "#8389FF", "solid": true, "key": ["#8389FF"]}, "favoritesContainerID": "C0000000-0000-0000-0000-000000000021", "pinnedContainerID": "C0000000-0000-0000-0000-000000000022", "todayContainerID": "C0000000-0000-0000-0000-000000000023", "createdAt": "2026-11-06T08:00:00Z"}], "items": [{"id": "C0000000-0000-0000-0000-000000000011", "children": [], "isUnread": false, "createdAt": "2026-11-06T08:00:00Z", "data": {"container": {"_0": {"favorites": {"spaceID": "A0000000-0000-0000-0000-000000000001"}}}}}, {"id": "C0000000-0000-0000-0000-000000000012", "children": ["F0000000-0000-0000-0000-000000000001", "F0000000-0000-0000-0000-000000000002"], "isUnread": false, "createdAt": "2026-11-06T08:00:00Z", "data": {"container": {"_0": {"pinned": {"spaceID": "A0000000-0000-0000-0000-000000000001"}}}}}, {"id": "C0000000-0000-0000-0000-000000000013", "children": [], "isUnread": false, "createdAt": "2026-11-06T08:00:00Z", "data": {"container": {"_0": {"today": {"spaceID": "A0000000-0000-0000-0000-000000000001"}}}}}, {"id": "C0000000-0000-0000-0000-000000000021", "children": [], "isUnread": false, "createdAt": "2026-11-06T08:00:00Z", "data": {"container": {"_0": {"favorites": {"spaceID": "A0000000-0000-