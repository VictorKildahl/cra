# promise: #315
# Full screen with the sidebar hidden fills the screen edge to edge, as in Arc (#315): the card
# drops its 10 pt inset and its rounding. With the sidebar shown it keeps them, as it does in a
# window. Card readout: insets from the window's left, bottom, right and top, then the radius.
# It takes over a Space, so it runs only with CRA_SCENARIO_SCREEN=1 (CI).
requires screen
budget rss=600 stalls50=10
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true}
cra://open?url=${PAGE}?n=main
wait 3
cra://debug?fullscreen=1
wait 3
cra://debug?windowState=full-sidebar
expect-log window state full-sidebar: main0 fullscreen=1 .* card=[0-9]+,10,10,10 r[1-9][0-9]* fills=0

cra://action/toggleSidebar
wait 2
cra://debug?windowState=full-hidden
expect-log window state full-hidden: main0 fullscreen=1 .* card=0,0,0,0 r0 fills=1

cra://debug?fullscreen=0
wait 3
cra://debug?windowState=windowed-hidden
expect-log window state windowed-hidden: main0 fullscreen=0 .* card=10,10,10,10 r[1-9][0-9]* fills=0

cra://action/toggleSidebar
wait 2
