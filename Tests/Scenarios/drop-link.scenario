# promise: #419
# A link dragged onto the tab list from a page or another app opens as a new tab where it is let
# go, behind the page you're on, as in Arc (1.173.1, measured): below the last row it is the end of
# Today, on a row's top quarter it goes before that row. Arc takes nothing on a tab's middle, puts
# a link let go on a folder's middle in the folder at the top, and takes only web pages. The
# insertion line is Arc's ring and line.
budget rss=800 stalls50=30
pace 0.5
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true, "showToolbar": false}

cra://open?url=${PAGE}?n=first
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
cra://open?url=${PAGE}?n=shown
wait 1
cra://debug?dropLink=${PAGE}?n=bottom&name=Dropped
# Arc's insertion line: its ring 2 pt before the favicon, the line's end 3 pt inside the row (#422).
expect-log dropLink: line lead=2 trail=3$
expect-log dropLink: opened \S*n=bottom
cra://debug?dropLink=${PAGE}?n=between&before=n=first
expect-log dropLink: opened \S*n=between
cra://debug?dropLink=${PAGE}?n=onto&onto=n=first
expect-log dropLink: line none$
expect-log dropLink: refused \S*n=onto
cra://debug?dropLink=file:///etc/hosts
expect-log dropLink: refused file:///etc/hosts
wait 1
# Newest first above them, as Today lists new tabs; the dropped ones where they were let go.
cra://debug?applescript=tell%20current%20application%20to%20get%20%C2%ABclass%20URL%20%C2%BB%20of%20%C2%ABclass%20tAbB%C2%BB%20of%20%C2%ABclass%20WiND%C2%BB%201
expect-log Cra applescript → .*\[ 'utxt'\("[^"]*n=shown"\), 'utxt'\("[^"]*n=between"\), 'utxt'\("[^"]*n=first"\), 'utxt'\("[^"]*n=bottom"\) \]>$
# The page you were on stays in front.
cra://debug?applescript=tell%20current%20application%20to%20get%20%C2%ABclass%20URL%20%C2%BB%20of%20%C2%ABclass%20acTa%C2%BB%20of%20%C2%ABclass%20WiND%C2%BB%201
expect-log Cra applescript → .*n=shown
# A closed folder's middle takes the link in, at the top, and the folder stays closed (Arc 1.173.1).
cra://action/newFolder
wait 1
cra://action/collapseAllFolders
wait 1
cra://debug?dropLink=${PAGE}?n=infolder&onto=New%20Folder
expect-log dropLink: opened \S*n=infolder in New Folder at 0
