# A subscription added in Privacy hides an element in an ordinary Chromium document.
# Switching the offline sources off preserves the subscription. Removing it restores the element.
port 47134
arg --host-resolver-rules=MAP reader.example 127.0.0.1
pace 0.5
budget rss=800 stalls50=30
cra://open?url=http://reader.example:47134/page.html?n=filter-list
expect-log loaded reader\.example \(HTTP 200\)
# The publisher insists the reserved slot should display. Only the layered filter
# wins while active; pausing and removing the filter must reveal the same slot.
cra://debug?cdp=Runtime.evaluate&params={"expression":"(()=>{const sheet=document.createElement('style');sheet.textContent='body div.iklan-banner { display: block !important }';document.head.append(sheet);return sheet.sheet.cssRules[0].style.getPropertyPriority('display')})()"}
expect-log Cra cdp Runtime.evaluate .*"value":"important"
cra://debug?cdp=Runtime.evaluate&params={"expression":"(()=>{const e=document.createElement('div');e.id='filter-list-fixture';e.className='iklan-banner';document.body.append(e);return 'before:'+getComputedStyle(e).display})()"}
expect-log Cra cdp Runtime.evaluate .*"value":"before:block"
cra://debug?blockLists=http://127.0.0.1:47134/blocklist-slot-selectors.txt
expect-log block lists: [0-9]+ domains, 1 added list
cra://debug?cdp=Runtime.evaluate&params={"expression":"'added:'+getComputedStyle(document.getElementById('filter-list-fixture')).display"}
expect-log Cra cdp Runtime.evaluate .*"value":"added:none"
# A slot created after page load collapses when the ad unit appears. The
# neighbouring story stays visible, and removing the unit restores the slot.
cra://debug?cdp=Runtime.evaluate&params={"expression":"(()=>{const slot=document.createElement('aside'),story=document.createElement('aside');slot.innerHTML='<div>Advertisement</div>';story.textContent='Story';document.body.append(slot,story);const visible=e=>getComputedStyle(e).display!=='none';const before=visible(slot);const unit=document.createElement('div');unit.dataset.adUnitId='banner';slot.firstChild.append(unit);const hidden=!visible(slot),storyVisible=visible(story);unit.remove();return [before,hidden,storyVisible,visible(slot)].join(',')})()"}
expect-log Cra cdp Runtime.evaluate .*"value":"true,true,true,true"
# The replacement hide rule matches only slots outside the style exclusion.
cra://debug?cdp=Runtime.evaluate&params={"expression":"(()=>{const slot=document.createElement('div');slot.id='div-gpt-ad-1';slot.textContent='Reserved';document.body.append(slot);const hidden=slot.offsetHeight===0;slot.setAttribute('style','width: 1px; height: 1px;');return 'qualified:'+hidden+','+(slot.offsetHeight>0)})()"}
expect-log Cra cdp Runtime.evaluate .*"value":"qualified:true,true"
cra://debug?cdp=Runtime.evaluate&params={"expression":"(()=>{const slot=document.createElement('div');slot.dataset.ad='unit';slot.dataset.adUnit='banner';document.body.append(slot);const empty=getComputedStyle(slot).display;slot.textContent='Publisher content';return ['empty-slot',empty,getComputedStyle(slot).display].join(',')})()"}
expect-log Cra cdp Runtime.evaluate .*"value":"empty-slot,none,block"
cra://debug?toggleSiteFilters=http://reader.example:47134/page.html
cra://debug?cdp=Runtime.evaluate&params={"expression":"'paused:'+getComputedStyle(document.getElementById('filter-list-fixture')).display"}
expect-log Cra cdp Runtime.evaluate .*"value":"paused:block"
cra://debug?toggleSiteFilters=http://reader.example:47134/page.html
cra://debug?cdp=Runtime.evaluate&params={"expression":"'resumed:'+getComputedStyle(document.getElementById('filter-list-fixture')).display"}
expect-log Cra cdp Runtime.evaluate .*"value":"resumed:none"
cra://debug?blockAds=off
expect-log block ads and trackers: off
cra://debug?cdp=Runtime.evaluate&params={"expression":"'off:'+getComputedStyle(document.getElementById('filter-list-fixture')).display"}
expect-log Cra cdp Runtime.evaluate .*"value":"off:none"
cra://debug?blockAds=on
expect-log block ads and trackers: on
cra://debug?cdp=Runtime.evaluate&params={"expression":"'on:'+getComputedStyle(document.getElementById('filter-list-fixture')).display"}
expect-log Cra cdp Runtime.evaluate .*"value":"on:none"
cra://debug?blockLists=none
expect-log block lists: [0-9]+ domains, 0 added lists
cra://debug?cdp=Runtime.evaluate&params={"expression":"'removed:'+getComputedStyle(document.getElementById('filter-list-fixture')).display"}
expect-log Cra cdp Runtime.evaluate .*"value":"removed:block"
