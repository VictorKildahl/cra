# promise: #507
# A block list added in Settings ▸ Privacy ▸ Block lists (#507) is fetched at launch and blocked
# with Cra's own: a third-party request to one of its domains fails and its server hears nothing,
# while a third party on neither list still loads. The list is ABPindo-style Adblock Plus syntax
# from the fixture server (Tests/Fixtures/Pages/blocklist-abp.txt); only its two ||domain^ rules
# apply. The names map to that server, so the run needs no network. The seeded address names the
# fixed port because seeds are written before the server starts.
# No & in a script: it ends the cra:// query.
budget rss=800 stalls50=30
port 47131
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true, "showToolbar": false, "customBlocklists": ["http://127.0.0.1:47131/blocklist-abp.txt"]}
arg --host-resolver-rules=MAP judi-slot.example 127.0.0.1, MAP *.judi-slot.example 127.0.0.1, MAP allowed.example 127.0.0.1, MAP *.omtrdc.net 127.0.0.1
pace 0.5

# Cra's own list and the added one reach the engine.
expect-log GET /blocklist-abp\.txt
expect-log block lists: [0-9]+ domains, 1 added list

cra://open?url=${PAGE}?n=custom-list
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)

# A third party on neither list is asked.
cra://debug?cdp=Runtime.evaluate&params={"expression":"fetch('http://allowed.example:'+location.port+'/page.html?probe=allowed',{mode:'no-cors'}).then(()=>'allowed fetch:sent',e=>'allowed fetch:'+e.name)","awaitPromise":true}
expect-log Cra cdp Runtime.evaluate .*"value":"allowed fetch:sent"
expect-log GET /page\.html\?probe=allowed

# A subdomain of a domain on the added list fails as a blocked request does.
cra://debug?cdp=Runtime.evaluate&params={"expression":"fetch('http://ads.judi-slot.example:'+location.port+'/page.html?probe=added-list',{mode:'no-cors'}).then(()=>'added fetch:sent',e=>'added fetch:'+e.name)","awaitPromise":true}
expect-log Cra cdp Runtime.evaluate .*"value":"added fetch:TypeError"
reject-log probe=added-list

# Cra's own list still blocks next to the added one: the two reach the engine as one set.
cra://debug?cdp=Runtime.evaluate&params={"expression":"fetch('http://nwfbr.tt.omtrdc.net:'+location.port+'/page.html?probe=own-list',{mode:'no-cors'}).then(()=>'own fetch:sent',e=>'own fetch:'+e.name)","awaitPromise":true}
expect-log Cra cdp Runtime.evaluate .*"value":"own fetch:TypeError"
reject-log probe=own-list
