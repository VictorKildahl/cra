# promise: #425
# A Peek on a call asks before it closes, as Arc's does: the first close (⌘W, the Close button, a click
# outside) turns Close into Arc's red Confirm pill (DestructiveButtonFace F53714, "Hang up" for its tip)
# and the Peek stays; the next ⌘W or Close goes through. A click outside keeps the pill up, and after
# 10 s it gives up and Close is round again. A Peek without a call closes at once (GitHub #425).
# Chrome's fake devices answer getUserMedia once the card is allowed, so no real microphone opens.
budget rss=900 stalls50=40
pace 0.5
arg --use-fake-device-for-media-stream
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true, "showToolbar": false, "peekInEveryTab": true}

cra://open?url=${PAGE}?n=hub
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
wait 1
cra://action/pinTab
wait 0.5

# No call: Close closes at once.
cra://debug?cdp=Runtime.evaluate&params={"expression":"String(!!window.open('${PAGE}?n=quiet'))","userGesture":true}
expect-log peek: from
wait 1.5
cra://debug?peekClose=quiet&attempt=closeButton
expect-log peek close quiet: open=0 capturing=0 hold=none close=34x33 fill=\S+ text=0
wait 1

# A call in the Peek.
cra://debug?cdp=Runtime.evaluate&params={"expression":"String(!!window.open('${PAGE}?n=call'))","userGesture":true}
expect-log peek: from
wait 1.5
cra://debug?target=little&cdp=Runtime.evaluate&params={"expression":"navigator.mediaDevices.getUserMedia({audio:true}).then(s=>{window.__mic=s});'asked'","returnByValue":true,"userGesture":true}
wait 2
cra://debug?permissionCard=Allow
expect-log permission card: .*; pressed Allow
wait 2
cra://debug?peekClose=calling
expect-log peek close calling: open=1 capturing=1 hold=none close=34x33 fill=\S+ text=0 tip=Close$

# ⌘W: the pill, and the Peek stays.
cra://debug?peekClose=first&attempt=closeShortcut
expect-log peek close first: open=1 capturing=1 hold=mediaInput close=\d+x33 fill=F53714 text=1 tip=Hang up$
# A click outside keeps it up.
cra://debug?peekClose=outside&attempt=background
expect-log peek close outside: open=1 capturing=1 hold=mediaInput close=\d+x33 fill=F53714 text=1
# It gives up after 10 s.
wait 10.5
cra://debug?peekClose=gaveUp
expect-log peek close gaveUp: open=1 capturing=1 hold=none close=34x33 fill=\S+ text=0 tip=Close$

# The Close button asks, and ⌘W then closes.
cra://debug?peekClose=again&attempt=closeButton
expect-log peek close again: open=1 capturing=1 hold=mediaInput
cra://debug?peekClose=second&attempt=closeShortcut
expect-log peek close second: open=0 capturing=1 hold=none
wait 1
cra://debug?peeks=gone
expect-log Cra peeks gone: none$
