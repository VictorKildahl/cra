{
  "manifest_version": 3,
  "name": "Cra Tabs Query Fixture",
  "version": "1.0",
  "description": "Made up for scripts/scenario.sh: its toolbar button opens a page naming how many tabs chrome.tabs.query and chrome.windows.getAll report, and how many of them have no address (a spare page Cra keeps ready must not be one).",
  "key": "",
  "permissions": [
    "tabs"
  ],
