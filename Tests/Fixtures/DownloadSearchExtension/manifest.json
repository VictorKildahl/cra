{
  "manifest_version": 3,
  "name": "Cra Download Search Fixture",
  "version": "1.0",
  "description": "Made up for scripts/scenario.sh: deletes each file it sees finish downloading, and lists the downloads with chrome.downloads.search whenever a page loads, as a download manager extension does (GitHub #519).",
  "key": "",
  "permissions": ["downloads", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "worker.js" }
}
