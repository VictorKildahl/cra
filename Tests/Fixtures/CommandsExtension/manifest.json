{
  "manifest_version": 3,
  "name": "Cra Commands Fixture",
  "version": "1.0",
  "description": "Made up for scripts/scenario.sh: a keyboard shortcut (commands) that opens its toolbar popup, as an extension's 'Activate the extension' shortcut in chrome://extensions/shortcuts does, and one of its own commands its service worker answers (GitHub #701), and a row of its own in its toolbar button's menu (chrome.contextMenus, #695). The popup and the worker load fixture pages to say what happened.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "origin.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cra Commands Fixture"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Open the popup"
    },
    "say-hello": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Say hello"
    }
  },
  "background": {
    "service_worker": "worker.js"
  }
}