{
  "manifest_version": 3,
  "name": "Cra Commands Fixture",
  "version": "1.0",
  "description": "Made up for scripts/scenario.sh: a keyboard shortcut (commands) that opens its toolbar popup, as an extension's 'Activate the extension' shortcut in chrome://extensions/shortcuts does (GitHub #701). Its popup loads a fixture page to say it opened.",
  "key": "",
  "permissions": ["storage"],
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["origin.js"] }],
  "action": { "default_popup": "popup.html", "default_title": "Cra Commands Fixture" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+Y" }, "description": "Open the popup" }
  }
}
