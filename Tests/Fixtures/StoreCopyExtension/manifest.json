{
  "manifest_version": 3,
  "name": "Cra Store Copy Fixture",
  "version": "1.0",
  "description": "Made up for scripts/scenario.sh: a Chrome Web Store extension's folder copy (its update_url is the store's), as Cra imports one from another browser.",
  "key": "",
  "update_url": "https://clients2.google.com/service/update2/crx",
  "permissions": [
    "sidePanel"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cra Store Copy Fixture"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}