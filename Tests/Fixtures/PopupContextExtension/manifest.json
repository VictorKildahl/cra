{
  "manifest_version": 3,
  "name": "Cra Popup Context Fixture",
  "version": "1.0",
  "description": "Made up for scripts/scenario.sh: its toolbar popup asks chrome.tabs.query for the active tab of the current and of the last focused window, as ZeroOmega's popup does for its per-site section (GitHub #699), and loads a fixture page naming what it got.",
  "key": "",
  "permissions": ["tabs", "storage"],
  "content_scripts": [{
    "matches": ["http://127.0.0.1/*"],
    "js": ["origin.js"]
  }],
  "action": { "default_popup": "popup.html", "default_title": "Cra Popup Context Fixture" }
}
