{
  "manifest_version": 3,
  "name": "Cra Side Panel Fixture",
  "version": "1.0",
  "description": "Made up for scripts/scenario.sh: like MetaMask, a popup in the manifest but the toolbar button opens the side panel.",
  "key": "",
  "permissions": ["sidePanel"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "Cra Side Panel Fixture" },
  "side_panel": { "default_path": "panel.html" }
}
