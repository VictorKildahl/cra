@@ -445,6 +446,17 @@ void UnpackedInstaller::InstallExtension() {
   // Force file access and/or incognito state and set install param if
   // requested.
   ExtensionPrefs* prefs = ExtensionPrefs::Get(browser_context_);
+  // Cra: developer mode never applies to a --load-extension extension. A
+  // reload used to turn one into kUnpacked, which got it this reason, and the
+  // reason stayed when the command line loaded it again: clear it.
+  if (extension()->location() == mojom::ManifestLocation::kCommandLine &&
+      prefs->HasDisableReason(
+          extension()->id(),
+          disable_reason::DISABLE_UNSUPPORTED_DEVELOPER_EXTENSION)) {
+    prefs->RemoveDisableReason(
+        extension()->id(),
+        disable_reason::DISABLE_UNSUPPORTED_DEVELOPER_EXTENSION);
+  }
   if (allow_file_access_.has_value()) {
     prefs->SetAllowFileAccess(extension()->id(), *allow_file_access_);
   }
