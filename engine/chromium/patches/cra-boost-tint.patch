+void GraphicsContext::SetCraTint(const float* matrix_4x5) {
+  if (!matrix_4x5) {
+    cra_tint_filter_ = nullptr;
+    return;
+  }
+  std::copy(matrix_4x5, matrix_4x5 + 20, cra_tint_matrix_.begin());
+  cra_tint_filter_ = cc::ColorFilter::MakeMatrix(cra_tint_matrix_.data());
+}
+
+SkColor4f GraphicsContext::CraTintColor(const SkColor4f& color) const {
+  const auto& m = cra_tint_matrix_;
+  const float in[4] = {color.fR, color.fG, color.fB, color.fA};
+  float out[4];
+  for (int row = 0; row < 4; ++row) {
+    float v = m[row * 5 + 4];
+    for (int col = 0; col < 4; ++col) {
+      v += m[row * 5 + col] * in[col];
+    }
+    out[row] = std::clamp(v, 0.f, 1.f);
+  }
+  return SkColor4f{out[0], out[1], out[2], out[3]};
+}
