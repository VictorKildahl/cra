+// Cra: Arc's Boost colorize (#602), in sRGB's HSL whatever the working space.
+class CraColorizeColorFilter final : public ColorFilter {
+ public:
+  explicit CraColorizeColorFilter(const float params[6])
+      : ColorFilter(Type::kCraColorize, Make(params)) {
+    std::copy(params, params + 6, params_);
+  }
+
+ private:
+  static sk_sp<SkColorFilter> Make(const float params[6]) {
+    static constexpr char kCode[] =
+        "uniform half hue, darkHue, satAdd, satKeep, lightLow, lightScale;"
+        "half enc(half c) { return c <= 0.0031308 ? 12.92 * c :"
+        "  1.055 * pow(c, 1.0 / 2.4) - 0.055; }"
+        "half dec(half c) { return c <= 0.04045 ? c / 12.92 :"
+        "  pow((c + 0.055) / 1.055, 2.4); }"
+        "half channel(half p, half q, half t) {"
+        "  t = fract(t);"
+        "  if (t < 1.0 / 6.0) return p + (q - p) * 6.0 * t;"
+        "  if (t < 0.5) return q;"
+        "  if (t < 2.0 / 3.0) return p + (q - p) * (2.0 / 3.0 - t) * 6.0;"
+        "  return p; }"
+        "half4 main(half4 color) {"
+        "  half4 c = unpremul(color);"
+        "  half3 lin = toLinearSrgb(c.rgb);"
+        "  half3 rgb = half3(enc(saturate(lin.r)), enc(saturate(lin.g)),"
+        "    enc(saturate(lin.b)));"
+        "  half mx = max(max(rgb.r, rgb.g), rgb.b);"
+        "  half mn = min(min(rgb.r, rgb.g), rgb.b);"
+        "  half l = (mx + mn) * 0.5;"
+        "  half d = mx - mn;"
+        "  half s = d <= 0.0 ? 0.0 : d / (1.0 - abs(2.0 * l - 1.0));"
+        "  half h = hue + darkHue * (1.0 - l);"
+        "  half S = saturate(satAdd + satKeep * s);"
+        "  half L = saturate(lightLow + lightScale * l);"
+        "  half q = L < 0.5 ? L * (1.0 + S) : L + S - L * S;"
+        "  half p = 2.0 * L - q;"
+        "  half3 o = half3(channel(p, q, h + 1.0 / 3.0), channel(p, q, h),"
+        "    channel(p, q, h - 1.0 / 3.0));"
+        "  o = half3(dec(o.r), dec(o.g), dec(o.b));"
+        "  return half4(fromLinearSrgb(o) * c.a, c.a); }";
+    static SkRuntimeEffect* const effect =
+        SkRuntimeEffect::MakeForColorFilter(SkString(kCode)).effect.release();
+    if (!effect) {
+      return nullptr;
+    }
+    SkRuntimeColorFilterBuilder builder(sk_ref_sp(effect));
+    builder.uniform("hue") = params[0];
+    builder.uniform("darkHue") = params[1];
+    builder.uniform("satAdd") = params[2];
+    builder.uniform("satKeep") = params[3];
+    builder.uniform("lightLow") = params[4];
+    builder.uniform("lightScale") = params[5];
+    return builder.makeColorFilter();
+  }
+  size_t SerializedDataSize() const override {
+    return PaintOpWriter::SerializedSizeOfElements(params_, 6);
+  }
+  void SerializeData(PaintOpWriter& writer) const override {
+    for (float f : params_) {
+      writer.Write(f);
+    }
+  }
+  float params_[6];
+};
