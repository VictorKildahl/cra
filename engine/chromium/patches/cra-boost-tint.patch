 namespace blink {
+
+namespace {
+
+// Cra: settings' craBoostColorMatrix, 20 comma-separated numbers (#602). False
+// when it is empty or isn't 20 numbers.
+bool CraBoostTint(const Settings* settings, std::array<float, 20>& matrix) {
+  if (!settings || settings->GetCraBoostColorMatrix().empty()) {
+    return false;
+  }
+  Vector<String> parts = settings->GetCraBoostColorMatrix().Split(',');
+  if (parts.size() != 20) {
+    return false;
+  }
+  for (wtf_size_t i = 0; i < 20; ++i) {
+    std::optional<float> value = StringToFloat(parts[i].StripWhiteSpace());
+    if (!value) {
+      return false;
+    }
+    matrix[i] = *value;
+  }
+  return true;
+}
