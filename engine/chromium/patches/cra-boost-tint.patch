 namespace {
 
+// Cra: settings' craBoostTint, Arc's colorize as 6 comma-separated numbers
+// (#602, cc::ColorFilter::MakeCraColorize). False when it is empty or isn't 6
+// numbers.
+bool CraBoostTint(const Settings* settings, std::array<float, 6>& params) {
+  if (!settings || settings->GetCraBoostTint().empty()) {
+    return false;
+  }
+  Vector<String> parts = settings->GetCraBoostTint().Split(',');
+  if (parts.size() != 6) {
+    return false;
+  }
+  for (wtf_size_t i = 0; i < 6; ++i) {
+    std::optional<float> value = StringToFloat(parts[i].StripWhiteSpace());
+    if (!value) {
+      return false;
+    }
+    params[i] = *value;
+  }
+  return true;
+}
+
