+// Cra: the frontend a shared extension's local and sync storage go through. Shared with other profiles from the
+// one it was set up in (GitHub discussion #595), it reads and writes that profile's data from every profile it is in;
+// session storage, managed storage and everything else stay this profile's.
+StorageFrontend* SettingsFunction::CraStorageFrontend() {
+  content::BrowserContext* context = browser_context();
+  if (cra::g_extension_storage_context && extension() &&
+      (storage_area() == StorageAreaNamespace::kLocal ||
+       storage_area() == StorageAreaNamespace::kSync)) {
+    context = cra::g_extension_storage_context(context, extension()->id());
+  }
+  return StorageFrontend::Get(context);
+}
