+base::DictValue ChromeTranslateClient::CraTranslateState() {
+  base::DictValue state;
+  if (!translate_manager_ || !web_contents()) {
+    return state;
+  }
+  const translate::LanguageState& language = GetLanguageState();
+  std::string source, target;
+  GetTranslateLanguages(web_contents(), &source, &target,
+                        /*for_display=*/false);
+  const GURL& url = web_contents()->GetLastCommittedURL();
+  state.Set("url", url.spec());
+  state.Set("source", source);
+  state.Set("current", language.current_language());
+  state.Set("target", target);
+  state.Set("available", language.translate_enabled());
+  state.Set("translated", language.IsPageTranslated());
+  state.Set("pending", language.translation_pending());
+  state.Set("neverSite", url.has_host() && GetTranslatePrefs()->IsSiteOnNeverPromptList(url.host()));
+  return state;
 }
 
