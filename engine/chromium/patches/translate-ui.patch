+
+// Cra: Cra draws Arc's translate UI itself, so the page's translate steps and state go to it
+// (cra::g_translate_state) instead of Chrome's bubble.
+const char* CraTranslateStepName(translate::TranslateStep step) {
+  switch (step) {
+    case translate::TRANSLATE_STEP_BEFORE_TRANSLATE:
+      return "offer";
+    case translate::TRANSLATE_STEP_TRANSLATING:
+      return "translating";
+    case translate::TRANSLATE_STEP_AFTER_TRANSLATE:
+      return "translated";
+    case translate::TRANSLATE_STEP_AFTER_UNDO:
+      return "reverted";
+    case translate::TRANSLATE_STEP_TRANSLATE_ERROR:
+      return "error";
+  }
+  return "";
+}
+
+// Sends the state, with `step` empty for a plain state change. False when the page isn't one of Cra's, which
+// then keeps Chrome's bubble.
+bool CraSendTranslateState(ChromeTranslateClient* client,
+                           std::string_view step,
+                           translate::TranslateErrors error,
+                           bool user_gesture) {
+  if (!cra::g_translate_state || !client->web_contents()) {
+    return false;
+  }
+  base::DictValue state = client->CraTranslateState();
+  state.Set("step", step);
+  state.Set("error", static_cast<int>(error));
+  state.Set("userGesture", user_gesture);
+  return cra::g_translate_state(client->web_contents(),
+                                base::WriteJson(state).value_or("{}"));
+}
+
+class CraTranslationObserver
+    : public translate::ContentTranslateDriver::TranslationObserver {
+ public:
+  explicit CraTranslationObserver(ChromeTranslateClient* client)
+      : client_(client) {}
+
+  void OnIsPageTranslatedChanged(content::WebContents* source) override {
+    CraSendTranslateState(client_, "", translate::TranslateErrors::NONE,
+                          false);
+  }
+  void OnTranslateEnabledChanged(content::WebContents* source) override {
+    CraSendTranslateState(client_, "", translate::TranslateErrors::NONE,
+                          false);
+  }
+
+ private:
+  raw_ptr<ChromeTranslateClient> client_;
+};
 
 }  // namespace
 
