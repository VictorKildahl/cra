 namespace {
 
+// Cra (docs/chromium-engine.md in the Cra repository): the tab-modal dialogs of a page Cra shows in its own
+// window (cra_hosted_page.h) go over that page, where Cra shows it: alert, confirm and prompt, the HTTP sign-in
+// prompt, the screen-share picker, passkeys, certificates. Chrome's host for them is its Browser's contents
+// area, and that Browser's window is never seen: a 1 pt strip along the top of Cra's window since Cra 0.1.49
+// (#346). Chrome centred each dialog on that strip, so on the whole window, over whichever page was there: the
+// alert of a split's right pane came up over the left pane (#574). The dialogs stay children of the Browser's
+// window (it rides on Cra's window, so they move with it); only where they go changes.
+class CraPageDialogHost : public WebContentsModalDialogHost,
+                          public content::WebContentsObserver,
+                          public base::SupportsUserData::Data {
+ public:
+  static CraPageDialogHost* For(content::WebContents* contents,
+                                views::Widget* widget) {
+    auto* host =
+        static_cast<CraPageDialogHost*>(contents->GetUserData(UserDataKey()));
+    if (!host) {
+      auto owned = std::make_unique<CraPageDialogHost>(contents);
+      host = owned.get();
+      contents->SetUserData(UserDataKey(), std::move(owned));
+    }
+    if (widget && host->widget_.get() != widget) {
+      host->widget_ = widget->GetWeakPtr();
+      host->NotifyPositionRequiresUpdate();
+    }
+    return host;
+  }
+
+  explicit CraPageDialogHost(content::WebContents* contents)
+      : content::WebContentsObserver(contents) {}
+  CraPageDialogHost(const CraPageDialogHost&) = delete;
+  CraPageDialogHost& operator=(const CraPageDialogHost&) = delete;
+  ~CraPageDialogHost() override {
+    observers_.Notify(&web_modal::ModalDialogHostObserver::OnHostDestroying);
+  }
+
+  // web_modal::WebContentsModalDialogHost:
+  gfx::NativeView GetHostView() const override {
+    return widget_ ? widget_->GetNativeView() : gfx::NativeView();
+  }
+  // Centred on the page, its top at the page's top.
+  gfx::Point GetDialogPosition(const gfx::Size& size) override {
+    const gfx::Rect page = PageInHost();
+    return gfx::Point(page.x() + std::max(0, (page.width() - size.width()) / 2),
+                      page.y());
+  }
+  gfx::Size GetMaximumDialogSize() override {
+    const gfx::Rect page = PageInHost();
+    return page.IsEmpty() ? gfx::Size(640, 480) : page.size();
+  }
+  // Only a page in sight takes the keys for its dialog (Return, Escape).
+  bool ShouldActivateDialog() const override {
+    return web_contents() &&
+           web_contents()->GetVisibility() == content::Visibility::VISIBLE;
+  }
+  void AddObserver(web_modal::ModalDialogHostObserver* observer) override {
+    observers_.AddObserver(observer);
+  }
+  void RemoveObserver(web_modal::ModalDialogHostObserver* observer) override {
+    observers_.RemoveObserver(observer);
+  }
+  void NotifyPositionRequiresUpdate() override {
+    observers_.Notify(
+        &web_modal::ModalDialogHostObserver::OnPositionRequiresUpdate);
+  }
+
+  // content::WebContentsObserver: the page came into sight, or Cra resized it (a window resized, the sidebar
+  // shown or hidden, a split). A move of Cra's window moves the dialog with it, a child window of a child.
+  void OnVisibilityChanged(content::Visibility visibility) override {
+    if (visibility != content::Visibility::HIDDEN) {
+      NotifyPositionRequiresUpdate();
+    }
+  }
+  void PrimaryMainFrameWasResized(bool width_changed) override {
+    NotifyPositionRequiresUpdate();
+  }
+  // The page is closing: its dialogs go now, while it is all still there. This host is the page's own data, so
+  // its destructor runs after the page's parts are gone, and a dialog closed from there (the HTTP sign-in
+  // prompt, LoginHandler::CancelAuth) used them (crash-sign-in-dialog-tab-closed).
+  void WebContentsDestroyed() override {
+    observers_.Notify(&web_modal::ModalDialogHostObserver::OnHostDestroying);
+  }
+
+ private:
+  static const void* UserDataKey() {
+    static const int key = 0;
+    return &key;
+  }
+
+  // The page's area in Cra's window, in the coordinates of the Browser's window (where a dialog's position is
+  // read from).
+  gfx::Rect PageInHost() const {
+    gfx::Rect page =
+        web_contents() ? web_contents()->GetContainerBounds() : gfx::Rect();
+    if (widget_) {
+      page.Offset(-widget_->GetClientAreaBoundsInScreen().OffsetFromOrigin());
+    }
+    return page;
+  }
+
+  base::WeakPtr<views::Widget> widget_;
+  base::ObserverList<web_modal::ModalDialogHostObserver> observers_;
+};
