+// static
+void UnpackedInstaller::SetBundledCraFilterActive(bool active) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (g_cra_filter_active != active) {
+    g_cra_filter_active = active;
+    CraFilterSubscribers().Notify();
+  }
+}
+
+// static
+bool UnpackedInstaller::DeferBundledCraFilter(content::BrowserContext* context,
+                                              const base::FilePath& path,
+                                              base::RepeatingClosure load) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!IsBundledCraFilterPath(path)) {
+    return false;
+  }
+  if (!context->GetUserData(&kCraFilterSubscriptionKey)) {
+    auto on_change = base::BindRepeating(
+        [](base::WeakPtr<content::BrowserContext> profile,
+           base::RepeatingClosure reload) {
+          if (!profile || profile->ShutdownStarted()) {
+            return;
+          }
+          if (g_cra_filter_active) {
+            // Re-enter the regular command-line policy and profile-scope checks.
+            reload.Run();
+          } else {
+            UnloadBundledCraFilter(profile.get());
+          }
+        }, context->GetWeakPtr(), std::move(load));
+    context->SetUserData(&kCraFilterSubscriptionKey,
+        std::make_unique<CraFilterSubscription>(
+            CraFilterSubscribers().Add(std::move(on_change))));
+  }
+  if (!g_cra_filter_active) {
+    UnloadBundledCraFilter(context);
+    return true;
+  }
+  return ExtensionRegistry::Get(context)->GetInstalledExtension(kCraFilterId) ||
+         IsBundledCraFilterPending(context);
+}
