 std::optional<gfx::Rect> BrowserWebContentsDelegate::GetWindowBoundsInScreen() {
+  // Cra: the window of a Browser that holds a profile's pages (cra_hosted_page.h) is never seen and only a
+  // strip along the top of Cra's window, while each page shows in Cra's own window. Chrome's file pickers ask
+  // for a window of at least 400x300 (WebContentsBasedCanceller::IsWindowTooSmall, crbug.com/479258455), and
+  // took the strip for the page's window: every upload button did nothing. The page in front, where Cra
+  // shows it, stands in for the window (a picker opens only for the active tab).
+  views::Widget* widget =
+      views::Widget::GetWidgetForNativeWindow(window_->GetNativeWindow());
+  if (widget && widget->GetNativeWindowProperty(views::kCraPageHostWindow)) {
+    if (content::WebContents* contents =
+            browser_->GetTabStripModel()->GetActiveWebContents()) {
+      return contents->GetContainerBounds();
+    }
+  }
   // Note that `GetBounds` here returns the screen coordinate bounds
   // from the browser widget. This is not to be confused with
   // `views::View::bounds()` which returns parent-relative bounds.
