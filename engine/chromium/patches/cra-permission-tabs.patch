--- /dev/null
+++ b/components/permissions/cra_permission_tabs.h
@@ -0,0 +1,20 @@
+// Cra's hook into the permission request manager (engine/chromium in the Cra repository). //cra sets it; Chrome
+// itself never does, so nothing here changes Chrome's behaviour.
+#ifndef COMPONENTS_PERMISSIONS_CRA_PERMISSION_TABS_H_
+#define COMPONENTS_PERMISSIONS_CRA_PERMISSION_TABS_H_
+
+namespace content {
+class WebContents;
+}
+
+namespace permissions::cra {
+
+// A page of Cra's hands its requests on at once, from any tab: Cra's app decides when a tab behind asks (it waits
+// for its tab, GitHub #286), as on CEF. Chrome holds a request while its tab isn't the active one, and Cra's
+// active tab is only ever the page the user is on.
+using AsksFromAnyTabHook = bool (*)(content::WebContents* contents);
+inline AsksFromAnyTabHook g_asks_from_any_tab = nullptr;
+
+}  // namespace permissions::cra
+
+#endif  // COMPONENTS_PERMISSIONS_CRA_PERMISSION_TABS_H_
