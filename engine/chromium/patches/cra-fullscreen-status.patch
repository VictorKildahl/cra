   if (!browser_->GetTabStripModel()->delegate()->IsTabStripEditable()) {
@@ -1216,12 +1226,20 @@
 void BrowserWebContentsDelegate::EnterFullscreenModeForTab(
     content::RenderFrameHost* requesting_frame,
     const blink::mojom::FullscreenOptions& options) {
+  if (cra::g_page_fullscreen &&
+      cra::g_page_fullscreen(
+          content::WebContents::FromRenderFrameHost(requesting_frame), true)) {
+    return;
