 bool BrowserWebContentsDelegate::CanEnterFullscreenModeForTab(
     content::RenderFrameHost* requesting_frame) {
+  // Cra: its pages go fullscreen in Cra's window (cra::g_page_fullscreen).
+  if (cra::g_page_is_fullscreen &&
