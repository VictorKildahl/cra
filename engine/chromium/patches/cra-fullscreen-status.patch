+  if (int cra_fullscreen = cra::g_page_is_fullscreen
+                               ? cra::g_page_is_fullscreen(web_contents)
+                               : -1;
+      cra_fullscreen >= 0) {
+    content::FullscreenState state;
+    state.target_mode = cra_fullscreen ? content::FullscreenMode::kContent
