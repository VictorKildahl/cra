+namespace {
+base::RepeatingCallback<void(content::WebContents*)>& CraListChanged() {
+  static base::NoDestructor<base::RepeatingCallback<void(content::WebContents*)>>
+      callback;
+  return *callback;
+}
+}  // namespace
+
+// static
+void PopupBlockerTabHelper::SetCraListChangedCallback(
+    base::RepeatingCallback<void(content::WebContents*)> callback) {
+  CraListChanged() = std::move(callback);
+}
+
+void PopupBlockerTabHelper::NotifyCraListChanged() {
+  if (CraListChanged()) {
+    CraListChanged().Run(web_contents());
+  }
+}
