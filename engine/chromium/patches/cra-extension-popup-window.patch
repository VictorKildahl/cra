+// Cra (docs/web-features.md in the Cra repository): whether `browser`'s window is the one in use. Cra shows a
+// page in its own window while the page's Browser keeps a window that is never seen and never active, so
+// chrome.action.openPopup() always failed ("inactive window"); Cra answers for its pages.
+bool CraWindowIsActive(BrowserWindowInterface& browser) {
+  if (browser.GetWindow()->IsActive()) {
+    return true;
+  }
+  tabs::TabInterface* tab = browser.GetActiveTabInterface();
+  return cra::g_page_window_active && tab &&
+         cra::g_page_window_active(tab->GetContents()) == 1;
+}
