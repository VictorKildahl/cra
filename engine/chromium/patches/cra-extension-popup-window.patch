+  if (browser && CraWindowIsActive(*browser)) {
+    return browser;
+  }
+  // Cra: its Browsers are never activated, so the last active one is the oldest; the one whose page is in
+  // Cra's window in use is the active one.
+  BrowserWindowInterface* cra_active = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* candidate) {
+        Profile* candidate_profile = candidate->GetProfile();
+        const bool matches =
+            candidate_profile == &profile ||
+            (check_incognito_profile &&
+             candidate_profile->GetOriginalProfile() ==
+                 profile.GetOriginalProfile());
+        if (matches && CraWindowIsActive(*candidate)) {
+          cra_active = candidate;
+          return false;
+        }
+        return true;
+      });
+  return cra_active;
 }
 
