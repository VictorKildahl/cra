   if (file.empty()) {
     ReportFailure(kDownloadDirectoryError, FAILURE_REASON_OTHER);
     return;
@@ -672,6 +687,11 @@ void WebstoreInstaller::StartCrxInstaller(const DownloadItem& download) {
 
 void WebstoreInstaller::ReportFailure(const std::string& error,
                                       FailureReason reason) {
+  // Cra: an install reports once; a late second report does nothing (it used
+  // to fail this CHECK and Release() a second time).
+  if (!success_callback_ && !failure_callback_) {
+    return;
+  }
   CHECK(failure_callback_);
   std::move(failure_callback_).Run(id_, error, reason);
   success_callback_ = base::NullCallback();
@@ -685,6 +705,10 @@ void WebstoreInstaller::ReportFailure(const std::string& error,
 }
 
 void WebstoreInstaller::ReportSuccess() {
+  // Cra: an install reports once (see ReportFailure).
+  if (!success_callback_ && !failure_callback_) {
+    return;
+  }
   CHECK(success_callback_);
   std::move(success_callback_).Run(id_);
   failure_callback_ = base::NullCallback();
