   DCHECK_CURRENTLY_ON(BrowserThread::UI);
 
+  // Cra: the install already ended (ReportSuccess or ReportFailure ran while
+  // the download path was being made): nothing left to download.
+  if (!success_callback_ && !failure_callback_) {
+    return;
+  }
