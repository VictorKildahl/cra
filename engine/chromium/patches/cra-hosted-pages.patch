+++ b/ui/views/controls/webview/cra_hosted_page.h
@@ -0,0 +1,17 @@
+// Copyright 2026 Cra. Use of this source code is governed by the MIT license (Cra's LICENSE).
+#ifndef UI_VIEWS_CONTROLS_WEBVIEW_CRA_HOSTED_PAGE_H_
+#define UI_VIEWS_CONTROLS_WEBVIEW_CRA_HOSTED_PAGE_H_
+
+namespace views {
+
+// Cra (docs/chromium-engine.md in the Cra repository): a page Cra shows in its own windows carries this user
+// data key. A WebView never attaches such a page's native view, so Chrome's (never shown) window doesn't take
+// it from Cra's, whichever tab Chrome has active.
+inline const void* CraHostedPageKey() {
+  static const int key = 0;
+  return &key;
+}
+
+}  // namespace views
+
+#endif  // UI_VIEWS_CONTROLS_WEBVIEW_CRA_HOSTED_PAGE_H_
