+// Cra: Chrome takes the (never shown) window that holds a profile's pages (cra_hosted_page.h) for the
+// current browser window, so a dialog for a page in Cra's own window went there and never showed:
+// Remove in chrome://extensions did nothing at all (GitHub #484). Without a parent the dialog shows
+// on its own, and Cra puts it over its window as a sheet would hang (Cra's ChromiumDialogs, #349).
+gfx::NativeWindow CraShownParent(gfx::NativeWindow parent) {
+  views::Widget* widget =
+      parent ? views::Widget::GetWidgetForNativeWindow(parent) : nullptr;
+  if (widget && widget->GetNativeWindowProperty(views::kCraPageHostWindow)) {
+    return gfx::NativeWindow();
+  }
+  return parent;
+}
+
 }  // namespace
 
