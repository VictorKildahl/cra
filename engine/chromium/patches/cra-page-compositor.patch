Cra: a page Cra hosts keeps its compositor while hidden. Cra's pages are views
in Cra's windows, not in Chrome's, so each draws with a compositor of its own
(BrowserCompositorMac's HasOwnCompositor), which Chrome dropped on every hide
and made again on every show: a new frame sink from the GPU process before the
page's first frame, one display refresh late on every tab switch (first
animation frame 8.9 ms after the show against 0.4 ms on CEF, where pages sat in
Chrome's windows). Hidden, the page is detached from it as from a dropped one,
and it draws one frame of a pixel before it stops drawing: a compositor keeps
the buffers of the last frame it drew (kept at full size, the GPU process held
11 MB a hidden page, 154 -> 372 MB at 20 tabs; with the pixel frame 146 MB).

diff --git a/content/browser/renderer_host/browser_compositor_view_mac.h b/content/browser/renderer_host/browser_compositor_view_mac.h
index 625bfb2402..dfeed7bc03 100644
--- a/content/browser/renderer_host/browser_compositor_view_mac.h
+++ b/content/browser/renderer_host/browser_compositor_view_mac.h
@@ -175,6 +175,8 @@ class CONTENT_EXPORT BrowserCompositorMac : public DelegatedFrameHostClient,
   State state_ = HasNoCompositor;
   void UpdateState();
   void TransitionToState(State new_state);
+  // Cra: stops a kept compositor once it has drawn its one-pixel frame.
+  void StopHiddenCompositor();
 
   // Weak pointer to the layer supplied and reset via SetParentUiLayer. |this|
   // is an observer of |parent_ui_layer_|, to ensure that |parent_ui_layer_|
@@ -187,6 +189,8 @@ class CONTENT_EXPORT BrowserCompositorMac : public DelegatedFrameHostClient,
   raw_ptr<ui::AcceleratedWidgetMacNSView> accelerated_widget_mac_ns_view_ =
       nullptr;
   std::unique_ptr<ui::RecyclableCompositorMac> recyclable_compositor_;
+  // Cra: |recyclable_compositor_| kept, not drawing, while the page is hidden.
+  bool own_compositor_hidden_ = false;
 
   std::unique_ptr<DelegatedFrameHost> delegated_frame_host_;
   std::unique_ptr<ui::LayerSurface> root_layer_;
