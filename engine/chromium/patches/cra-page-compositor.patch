   // If the host is visible and a compositor is required then create one.
   if (!render_widget_host_is_hidden_) {
+    // Cra: a page shown again draws with the compositor it kept while hidden.
+    if (state_ == HasOwnCompositor && own_compositor_hidden_) {
+      own_compositor_hidden_ = false;
+      ui::Compositor* compositor = recyclable_compositor_->compositor();
+      display::ScreenInfo current = client_->GetCurrentScreenInfo();
+      recyclable_compositor_->UpdateSurface(
+          dfh_size_pixels_, current.device_scale_factor,
+          current.display_color_spaces, current.display_id,
+          current.display_frequency);
+      compositor->SetRootLayer(root_layer_.get());
+      compositor->SetVisible(true);
+      delegated_frame_host_->AttachToCompositor(compositor);
+      delegated_frame_host_->WasShown(GetRendererLocalSurfaceId(),
+                                      dfh_size_dip_,
+                                      {} /* record_tab_switch_time_request */);
+      return;
+    }
     TransitionToState(HasOwnCompositor);
     return;
   }
 
+  // Cra: a page Cra hosts outside Chrome's windows has a compositor of its
+  // own, and a new one on every show took a frame sink from the GPU process
+  // first: the page's first frame came a display refresh later on every tab
+  // switch. It keeps the compositor with the page detached from it, as from
+  // a dropped one, and draws one frame of a pixel before it stops drawing: a
+  // compositor keeps the buffers of the last frame it drew, 11 MB a hidden
+  // page at full size.
+  if (state_ == HasOwnCompositor) {
+    if (!own_compositor_hidden_) {
+      own_compositor_hidden_ = true;
+      delegated_frame_host_->DetachFromCompositor();
+      delegated_frame_host_->WasHidden(DelegatedFrameHost::HiddenCause::kOther);
+      ui::Compositor* compositor = recyclable_compositor_->compositor();
+      compositor->SetRootLayer(nullptr);
+      display::ScreenInfo current = client_->GetCurrentScreenInfo();
+      recyclable_compositor_->UpdateSurface(
+          gfx::Size(1, 1), current.device_scale_factor,
+          current.display_color_spaces, current.display_id,
+          current.display_frequency);
+      compositor->ScheduleFullRedraw();
+      GetUIThreadTaskRunner({})->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&BrowserCompositorMac::StopHiddenCompositor,
+                         weak_factory_.GetWeakPtr()),
+          base::Milliseconds(200));
+    }
+    return;
+  }
+
   // Otherwise put the compositor up for recycling.
   TransitionToState(HasNoCompositor);
 }
 
+void BrowserCompositorMac::StopHiddenCompositor() {
+  if (state_ == HasOwnCompositor && own_compositor_hidden_) {
+    recyclable_compositor_->compositor()->SetVisible(false);
+  }
+}
