 const char WasInProgressData::kKey[] =
   "DownloadItem DownloadStatusUpdater WasInProgressData";
 
+// Cra: whether the Dock tile counts a download. Chrome's download UI shows neither a transient download nor a
+// Web Store install's own CRX download, and Cra's downloads list doesn't either; the tile counted them, so an
+// imported extension's store reinstall put a download on Cra's Dock icon at every launch that no list had
+// (GitHub #491).
+bool CraShowsOnDock(const download::DownloadItem* item) {
+  return !item->IsTransient() &&
+         item->GetDownloadSource() !=
+             download::DownloadSource::EXTENSION_INSTALLER;
+}
+
