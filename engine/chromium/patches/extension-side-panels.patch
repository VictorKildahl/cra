   return GetTabRegistry(tabs::TabInterface::MaybeGetFromContents(web_contents));
 }
 
+// Cra: see SetCraSidePanelHandler.
+CraSidePanelHandler g_cra_side_panel_handler = nullptr;
+
+// Cra: hands the request to Cra's handler. `web_contents` defaults to the window's active page. True when
+// Cra took it.
+bool ForwardToCra(BrowserWindowInterface* browser_window,
+                  content::WebContents* web_contents,
+                  const ExtensionId& extension_id,
+                  CraSidePanelRequest request) {
+  if (!g_cra_side_panel_handler || !browser_window) {
+    return false;
+  }
+  if (!web_contents) {
+    tabs::TabInterface* tab = GetActiveTab(browser_window);
+    web_contents = tab ? tab->GetContents() : nullptr;
+  }
+  return web_contents &&
+         g_cra_side_panel_handler(web_contents, extension_id, request);
+}
