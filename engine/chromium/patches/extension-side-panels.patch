 }  // namespace content
 
 namespace extensions::side_panel_util {
+
+// Cra: Cra shows extension side panels in its own windows. While a handler is set (Cra's engine layer sets
+// it), a request goes to it with the browser's active page (or the page given) instead of to Chrome's side
+// panel, which Chrome's never-shown window can't show. The handler returns false to leave it to Chrome.
+enum class CraSidePanelRequest { kToggle, kOpen, kClose };
+using CraSidePanelHandler = bool (*)(content::WebContents* web_contents,
+                                     const ExtensionId& extension_id,
+                                     CraSidePanelRequest request);
+void SetCraSidePanelHandler(CraSidePanelHandler handler);
 
 // Toggles the side panel for the given `extension_id` in `browser_window`,
 // opening the panel if it is closed and closing it if it is open.
diff --git a/chrome/browser/ui/extensions/extension_side_panel_utils.cc b/chrome/browser/ui/extensions/extension_side_panel_utils.cc
--- a/chrome/browser/ui/extensions/extension_side_panel_utils.cc
+++ b/chrome/browser/ui/extensions/extension_side_panel_utils.cc
