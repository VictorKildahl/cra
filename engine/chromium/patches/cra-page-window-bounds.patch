 gfx::Rect RenderWidgetHostViewMac::GetBoundsInScreen() {
+  // Cra: a page Cra hosts sits in Cra's window beside its sidebar, not in a
+  // window of Chrome's. The window the page sees (window.outerWidth, screenX)
+  // is its own column, from the window's top to the page's bottom, as a page
+  // in Chrome's window sees its window. With the sidebar counted, outerWidth -
+  // innerWidth was over 300, and sites took it for open DevTools: Discord took
+  // its sign-in out of storage, so its other tabs opened signed out. The
+  // page's own bounds (GetViewBounds) stay as they are.
+  if (!cra_has_parent_ui_layer_ && widget_type_ == WidgetType::kFrame &&
+      !IsHeadless() && !window_frame_in_screen_dip_.IsEmpty()) {
+    const gfx::Rect view = GetViewBounds();
+    const int top = window_frame_in_screen_dip_.y();
+    if (view.width() > 0 && view.bottom() > top)
+      return gfx::Rect(view.x(), top, view.width(), view.bottom() - top);
+  }
   return window_frame_in_screen_dip_;
 }
 
