# Cra's layer in Chrome's framework (docs/chromium-engine.md in the Cra repository). Linked into
# //chrome:chrome_dll by engine/chromium/apply.sh.

source_set("core") {
  sources = [
    "CraCEF.h",
    "CraContentBlocker.h",
    "bridge.h",
    "bridge.mm",
    "downloads.h",
    "downloads.mm",
    "fetch.h",
    "fetch.mm",
    "history.h",
    "history.mm",
    "managed_extensions.h",
    "managed_extensions.mm",
    "engine_main.mm",
    "page_protocol.h",
    "page_protocol.mm",
    "permission_prompt.h",
    "permission_prompt.mm",
    "profile_prefs.h",
    "profile_prefs.mm",
    "spike_checks.h",
    "spike_checks.mm",
  ]
  frameworks = [ "Cocoa.framework" ]
  deps = [
    "//base",
    "//chrome/browser",
    "//chrome/browser/prefs:util",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/permissions/system",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/exclusive_access",
    "//chrome/browser/ui/tabs:tab_strip",
    "//content/public/browser",
    "//extensions/common",
    "//ui/gfx",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//chrome/browser/ui/extensions:extensions",
    "//chrome/browser/lifetime:lifetime",
    "//chrome/browser/ui:browser_tabstrip",
    "//url",
    "//chrome/browser/ui:browser_commands",
    "//extensions/browser:webstore_installer",
    "//chrome/browser/printing:printing",
    "//chrome/browser/devtools:devtools_toggle_action",
    "//chrome/browser/devtools:devtools",
    "//components/find_in_page:find_in_page",
    "//components/infobars/content",
    "//components/infobars/core",
    "//chrome/browser/ui/tab_sharing",
    "//chrome/browser/ui/views/tab_sharing",
    "//components/favicon/content:content",
    "//chrome/browser/picture_in_picture:picture_in_picture",
    "//chrome/browser/translate:translate",
    "//base/version_info",
    "//chrome/common",
    "//chrome/common:constants",
    "//components/tabs:public",
    "//net",
    "//ui/base",
    "//ui/views",
    "//chrome/browser/ui:browser_element_identifiers",
    "//chrome/browser/ui/interaction",
