# Cra's layer in Chrome's framework (docs/chromium-engine.md in the Cra repository). Linked into
# //chrome:chrome_dll by engine/chromium/apply.sh.

source_set("core") {
  sources = [
    "CraCEF.h",
    "CraContentBlocker.h",
    "bridge.h",
    "bridge.mm",
    "downloads.h",
    "downloads.mm",
    "fetch.h",
    "fetch.mm",
    "engine_main.mm",
    "page_protocol.h",
    "page_protocol.mm",
    "permission_prompt.h",
    "permission_prompt.mm",
    "profile_prefs.h",
    "profile_prefs.mm",
    "spike_checks.h",
    "spike_checks.mm",
  ]
  frameworks = [ "Cocoa.framework" ]
  deps = [
    "//base",
    "//chrome/browser",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/tabs:tab_strip",
    "//content/public/browser",
    "//extensions/common",
    "//ui/gfx",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//chrome/browser/ui/extensions:extensions",
    "//chrome/browser/lifetime:lifetime",
    "//chrome/browser/ui:browser_tabstrip",
    "//url",
    "//extensions/browser:webstore_installer",
    "//chrome/browser/printing:printing",
    "//chrome/browser/devtools:devtools_toggle_action",
    "//chrome/browser/devtools:devtools",
    "//components/find_in_page:find_in_page",
    "//components/favicon/content:content",
    "//chrome/browser/picture_in_picture:picture_in_picture",
    "//chrome/browser/translate:translate",
    "//base/version_info",
    "//chrome/common:constants",
    "//components/tabs:public",
    "//net",
    "//ui/base",
    "//chrome/browser:chrome_browser_application_mac",
    "//components/keep_alive_registry",
    "//components/prefs",
    "//components/translate/content/browser",
    "//components/translate/core/browser",
    "//components/performance_manager",
    "//components/sessions",
    "//extensions/browser",
    "//extensions/common:mojom",
  ]
}
